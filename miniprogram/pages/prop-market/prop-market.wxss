/* 道具市场 — 轻复古·奶油风 · 24rpx 基准 */

/* 页面容器 */
.pm-page {
  min-height: 100vh;
  background: var(--bg-primary);
}

/* 页面头部 */
.pm-header {
  background: linear-gradient(135deg, var(--gold-400), var(--gold-500));
  padding: 48rpx 32rpx;
  border-radius: 32rpx;
  margin-bottom: 32rpx;
  box-shadow: var(--shadow-gold);
  text-align: center;
}

.pm-header-title {
  display: block;
  font-size: 36rpx;
  font-weight: 700;
  color: var(--text-inverse);
  margin-bottom: 12rpx;
}

.pm-header-sub {
  display: block;
  font-size: 24rpx;
  color: rgba(255, 255, 255, 0.8);
}

/* 搜索框 */
.pm-search {
  display: flex;
  align-items: center;
  background: var(--bg-card);
  border-radius: 9999rpx;
  padding: 16rpx 28rpx;
  border: 2rpx solid var(--border-light);
  margin-bottom: 24rpx;
  box-shadow: var(--shadow-sm);
}

.pm-search-icon {
  margin-right: 12rpx;
  color: var(--gold-400);
}

.pm-search-input {
  flex: 1;
  font-size: 26rpx;
}

/* 分类切换 */
.pm-categories {
  display: flex;
  gap: 16rpx;
  margin-bottom: 32rpx;
  white-space: nowrap;
}

.pm-cat {
  padding: 16rpx 32rpx;
  border-radius: 999rpx;
  font-size: 26rpx;
  color: var(--gold-700);
  background: linear-gradient(135deg, var(--bg-card), var(--gold-50));
  border: 2rpx solid var(--gold-200);
  cursor: pointer;
  box-shadow: var(--shadow-sm);
  transition: all 0.2s ease;
  white-space: nowrap;
}

.pm-cat:active {
  transform: scale(0.95);
}

.pm-cat-active {
  background: linear-gradient(135deg, var(--gold-400), var(--gold-500));
  border-color: var(--gold-400);
  box-shadow: var(--shadow-gold);
  color: var(--text-inverse);
  font-weight: 600;
}

/* 加载状态 */
.pm-loading {
  display: flex;
  flex-direction: column;
  align-items: center;
  justify-content: center;
  padding: 80rpx 0;
}

.pm-loading-text {
  font-size: 26rpx;
  color: var(--gold-500);
  margin-top: 24rpx;
}

/* 空状态 */
.pm-empty {
  display: flex;
  flex-direction: column;
  align-items: center;
  justify-content: center;
  padding: 80rpx 0;
}

.pm-empty-title {
  font-size: 30rpx;
  font-weight: 700;
  color: var(--gold-800);
  margin-top: 24rpx;
  margin-bottom: 8rpx;
}

.pm-empty-desc {
  font-size: 24rpx;
  color: var(--gold-500);
}

/* 道具列表 */
.pm-list {
  display: flex;
  flex-direction: column;
  gap: 24rpx;
}

/* 道具卡片 */
.pm-item {
  display: flex;
  gap: 20rpx;
  background: linear-gradient(135deg, var(--bg-card), var(--gold-50));
  border: 2rpx solid var(--gold-100);
  box-shadow: var(--shadow-md);
  border-radius: 32rpx;
  padding: 28rpx;
  cursor: pointer;
  transition: all 0.2s ease;
}

.pm-item:active {
  transform: translateY(-4rpx);
  box-shadow: var(--shadow-lg);
}

/* 左侧图标 */
.pmi-icon {
  width: 96rpx;
  height: 96rpx;
  border-radius: 24rpx;
  background: linear-gradient(135deg, var(--gold-100), var(--gold-200));
  display: flex;
  align-items: center;
  justify-content: center;
  flex-shrink: 0;
  color: var(--gold-600);
}

/* 中间信息 */
.pmi-info {
  flex: 1;
  min-width: 0;
}

.pmi-name-row {
  display: flex;
  align-items: center;
  justify-content: space-between;
  margin-bottom: 8rpx;
}

.pmi-name {
  font-size: 28rpx;
  font-weight: 700;
  color: var(--gold-800);
  overflow: hidden;
  text-overflow: ellipsis;
  white-space: nowrap;
}

.pmi-price {
  font-family: var(--font-en-display);
  font-size: 32rpx;
  font-weight: 700;
  color: var(--gold-600);
  flex-shrink: 0;
}

.pmi-desc {
  font-size: 24rpx;
  color: var(--gold-500);
  line-height: 1.6;
  overflow: hidden;
  text-overflow: ellipsis;
  display: -webkit-box;
  -webkit-line-clamp: 2;
  -webkit-box-orient: vertical;
  margin-bottom: 12rpx;
}

.pmi-footer {
  display: flex;
  align-items: center;
  justify-content: space-between;
}

.pmi-platform {
  font-size: 22rpx;
  color: var(--gold-500);
  padding: 4rpx 12rpx;
  background: var(--gold-100);
  border-radius: 999rpx;
}

.pmi-arrow {
  color: var(--gold-400);
  opacity: 0.6;
}

/* 分类标签 */
.category-tabs {
  display: flex;
  gap: 16rpx;
  margin-bottom: 32rpx;
  flex-wrap: wrap;
}

.category-tab {
  padding: 16rpx 32rpx;
  border-radius: 999rpx;
  font-size: 26rpx;
  color: var(--gold-700);
  background: linear-gradient(135deg, var(--bg-card), var(--gold-50));
  border: 2rpx solid var(--gold-200);
  cursor: pointer;
  box-shadow: var(--shadow-sm);
  transition: all 0.2s ease;
}

.category-tab:active {
  transform: scale(0.95);
}

.category-tab.active {
  background: linear-gradient(135deg, var(--gold-400), var(--gold-500));
  border-color: var(--gold-400);
  box-shadow: var(--shadow-gold);
  color: var(--text-inverse);
  font-weight: 600;
}

/* 道具卡片 */
.prop-card {
  background: linear-gradient(135deg, var(--bg-card), var(--gold-50));
  border: 2rpx solid var(--gold-100);
  box-shadow: var(--shadow-md);
  border-radius: 32rpx;
  padding: 28rpx;
  margin-bottom: 24rpx;
  cursor: pointer;
  transition: all 0.2s ease;
}

.prop-card:active {
  transform: translateY(-4rpx);
  box-shadow: var(--shadow-lg);
}

.prop-image {
  width: 100%;
  height: 240rpx;
  border-radius: 24rpx;
  background: linear-gradient(135deg, var(--gold-100), var(--gold-200));
  margin-bottom: 20rpx;
  display: flex;
  align-items: center;
  justify-content: center;
  font-size: 80rpx;
  color: var(--gold-500);
}

.prop-name {
  font-size: 30rpx;
  font-weight: 700;
  color: var(--gold-800);
  margin-bottom: 12rpx;
}

.prop-desc {
  font-size: 24rpx;
  color: var(--gold-500);
  line-height: 1.6;
  margin-bottom: 16rpx;
}

.prop-footer {
  display: flex;
  justify-content: space-between;
  align-items: center;
}

.prop-price {
  font-family: var(--font-en-display);
  font-size: 36rpx;
  font-weight: 700;
  color: var(--gold-600);
}

.prop-unit {
  font-size: 24rpx;
  color: var(--gold-500);
  font-weight: 500;
}

.prop-btn {
  padding: 16rpx 32rpx;
  border-radius: 999rpx;
  font-size: 24rpx;
  font-weight: 600;
  background: linear-gradient(135deg, var(--gold-400), var(--gold-500));
  color: var(--text-inverse);
  border: none;
  box-shadow: var(--shadow-gold);
  cursor: pointer;
}

.prop-btn:active {
  transform: scale(0.95);
}
