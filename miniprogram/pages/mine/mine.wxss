/* ==============================================
   pages/mine/mine.wxss — 我的页面
   轻复古·奶油风 Profile Page
   ============================================== */

.mine-page {
  min-height: 100vh;
  padding: 24rpx 48rpx 64rpx;
  background: var(--bg);
  box-sizing: border-box;
}

/* 用户信息头 */
.mine-header {
  display: flex;
  align-items: center;
  gap: 32rpx;
  padding: 56rpx 48rpx;
  margin-bottom: 32rpx;
  border-radius: var(--radius-lg);
  background: linear-gradient(135deg, var(--gold-300), var(--gold-500));
  box-shadow: var(--shadow-md);
}

.avatar-wrap {
  width: 128rpx;
  height: 128rpx;
  border-radius: 50%;
  background: rgba(255,255,255,0.35);
  overflow: hidden;
  display: flex;
  align-items: center;
  justify-content: center;
  flex-shrink: 0;
  border: 4rpx solid rgba(255,255,255,0.5);
}

.avatar {
  width: 100%;
  height: 100%;
}

.avatar-text {
  font-size: 56rpx;
  font-weight: 700;
  color: var(--text-inverse);
}

.user-info {
  display: flex;
  flex-direction: column;
  gap: 16rpx;
}

.user-name {
  font-size: 44rpx;
  font-weight: 700;
  color: var(--text-inverse);
}

.countdown-wrap {
  display: inline-flex;
  align-items: center;
  gap: 12rpx;
  padding: 12rpx 28rpx;
  background: rgba(255,255,255,0.25);
  border-radius: 9999rpx;
}

.countdown-text {
  font-size: 24rpx;
  color: var(--text-inverse);
  font-weight: 500;
}

/* 工具箱 */
.tools-card {
  display: flex;
  justify-content: space-around;
  padding: 48rpx 32rpx;
  margin-bottom: 32rpx;
  background: var(--bg-card);
  border-radius: var(--radius-lg);
  box-shadow: var(--shadow-sm);
}

.tool-item {
  display: flex;
  flex-direction: column;
  align-items: center;
  gap: 20rpx;
  cursor: pointer;
}

.tool-item:active {
  opacity: 0.75;
}

.tool-icon-wrap {
  width: 112rpx;
  height: 112rpx;
  border-radius: 50%;
  background: var(--gold-100);
  display: flex;
  align-items: center;
  justify-content: center;
}

.tool-label {
  font-size: 24rpx;
  color: var(--text-primary);
  font-weight: 500;
}

/* 菜单卡片 */
.menu-card {
  background: var(--bg-card);
  border-radius: var(--radius-lg);
  padding: 16rpx 40rpx;
  box-shadow: var(--shadow-sm);
}

.menu-item {
  display: flex;
  align-items: center;
  justify-content: space-between;
  padding: 32rpx 0;
  cursor: pointer;
}

.menu-item:active {
  opacity: 0.7;
}

.menu-left {
  display: flex;
  align-items: center;
  gap: 24rpx;
}

.menu-text {
  font-size: 30rpx;
  color: var(--text-primary);
  font-weight: 500;
}

.menu-right {
  display: flex;
  align-items: center;
  gap: 16rpx;
}

.menu-badge {
  font-size: 24rpx;
  color: var(--gold-500);
}

.menu-arrow {
  font-size: 36rpx;
  color: var(--gold-400);
}

.menu-divider {
  height: 2rpx;
  background: var(--gold-100);
}

/* 验证卡 */
.verify-card {
  margin-top: 32rpx;
  padding: 32rpx 40rpx;
  background: var(--bg-card);
  border-radius: var(--radius-lg);
  box-shadow: var(--shadow-sm);
}

.verify-hint {
  font-size: 24rpx;
  color: var(--gold-500);
}

.verify-row {
  display: flex;
  gap: 20rpx;
  margin-top: 20rpx;
}

.verify-input {
  flex: 1;
  height: 80rpx;
  padding: 0 28rpx;
  background: var(--bg);
  border: 2rpx solid var(--gold-200);
  border-radius: var(--radius);
  font-size: 28rpx;
  color: var(--text-primary);
}

.verify-btn {
  width: 144rpx;
  height: 80rpx;
  display: flex;
  align-items: center;
  justify-content: center;
  background: var(--gold-400);
  border-radius: var(--radius);
  font-size: 28rpx;
  color: var(--text-inverse);
  font-weight: 500;
}

.verify-btn:active {
  opacity: 0.9;
}

.verify-error {
  display: block;
  margin-top: 16rpx;
  font-size: 24rpx;
  color: var(--gold-500);
}

/* 策划师模式提示 */
.planner-tip {
  display: flex;
  align-items: center;
  justify-content: space-between;
  margin-top: 32rpx;
  padding: 28rpx 40rpx;
  background: var(--gold-50);
  border-radius: var(--radius-lg);
}

.planner-tip-text {
  font-size: 28rpx;
  color: var(--gold-600);
  font-weight: 500;
}

.switch-btn {
  display: flex;
  align-items: center;
  justify-content: center;
  padding: 12rpx 28rpx;
  background: var(--gold-400);
  border-radius: var(--radius);
  font-size: 24rpx;
  color: var(--text-inverse);
  line-height: 1;
}

.switch-btn:active {
  opacity: 0.9;
}

/* 页脚 */
.mine-footer {
  display: flex;
  flex-direction: column;
  align-items: center;
  padding: 64rpx 0 32rpx;
  font-size: 22rpx;
  color: var(--gold-500);
}

/* ═══════════════════════════════════════════════
   ENHANCED MINE PAGE — Design Canvas Migration
   从设计画布迁移的我的页面增强样式
   ═══════════════════════════════════════════════ */

/* ---------- 用户信息头增强 ---------- */
.mine-header {
  background: linear-gradient(135deg, var(--gold-300), var(--gold-500));
  box-shadow: 0 8rpx 24rpx rgba(193, 154, 80, 0.2);
}

.avatar-wrap {
  background: rgba(255, 255, 255, 0.3);
  border: 4rpx solid rgba(255, 255, 255, 0.5);
  box-shadow: 0 4rpx 16rpx rgba(0, 0, 0, 0.1);
}

/* ---------- 工具箱增强 ---------- */
.tools-card {
  background: linear-gradient(135deg, var(--bg-card), var(--gold-50));
  border: 2rpx solid var(--gold-100);
  box-shadow: var(--shadow-md);
}

.tool-icon-wrap {
  background: linear-gradient(135deg, var(--gold-100), var(--gold-200));
  box-shadow: var(--shadow-sm);
  transition: all 0.2s ease;
}

.tool-item:active .tool-icon-wrap {
  transform: translateY(-4rpx);
  box-shadow: var(--shadow-md);
}

/* ---------- 菜单卡片增强 ---------- */
.menu-card {
  background: linear-gradient(135deg, var(--bg-card), var(--gold-50));
  border: 2rpx solid var(--gold-100);
  box-shadow: var(--shadow-md);
}

.menu-item {
  transition: background 0.15s ease;
}

.menu-item:active {
  background: var(--gold-50);
}

/* ---------- 倒计时徽章增强 ---------- */
.countdown-wrap {
  background: rgba(255, 255, 255, 0.25);
  backdrop-filter: blur(8rpx);
  -webkit-backdrop-filter: blur(8rpx);
}
