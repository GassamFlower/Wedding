/* 筹备清单专属样式 */

/* 按钮重置：覆盖原生 button 默认样式 */
.checklist-actions button {
  width: 100%;
  margin: 0;
  padding: 0;
  line-height: 1;
  font-size: inherit;
  font-weight: inherit;
  color: inherit;
  background: transparent;
  border: none;
  border-radius: 0;
}
.checklist-actions button::after {
  display: none;
}

.checklist-stage-icon {
  width:72rpx; height:72rpx;
  border-radius:50%;
  background:var(--gold-bg);
  display:flex; align-items:center; justify-content:center;
  flex-shrink:0;
  transition:all .3s ease;
}
.checklist-stage-icon.stage-done {
  background:var(--gold);
}

.checklist-item {
  display:flex; align-items:flex-start; gap:20rpx;
  padding:20rpx 0;
  border-bottom:2rpx solid rgba(232,224,212,0.4);
  transition:all .2s ease;
}
.checklist-item:last-child { border-bottom:none; }
.checklist-item:active { background:rgba(193,154,80,0.04); }
.checklist-item.checked .checklist-text {
  color:var(--text-muted);
  text-decoration:line-through;
  text-decoration-color:rgba(193,154,80,0.4);
}

.checklist-check {
  width:44rpx; height:44rpx;
  border-radius:12rpx;
  border:4rpx solid var(--border);
  display:flex; align-items:center; justify-content:center;
  flex-shrink:0;
  margin-top:2rpx;
  transition:all .2s ease;
}
.checklist-item.checked .checklist-check {
  background:var(--gold);
  border-color:var(--gold);
}
.checklist-text {
  flex:1;
  transition:color .2s ease;
}

.checklist-tip {
  display:flex;
  padding:16rpx 20rpx;
  background:rgba(193,154,80,0.05);
  border-radius:16rpx;
}

/* ring-wrap 已存在于全局样式中，这里仅做微调 */

/* ═══════════════════════════════════════════════
   ENHANCED CHECKLIST — Design Canvas Migration
   从设计画布迁移的筹备清单增强样式
   ═══════════════════════════════════════════════ */

/* ---------- 进度区域增强 ---------- */
.checklist-progress {
  background: linear-gradient(135deg, var(--bg-card), var(--gold-50));
  border: 2rpx solid var(--gold-100);
  box-shadow: var(--shadow-md);
  border-radius: var(--radius-lg);
  padding: 40rpx;
  margin-bottom: 32rpx;
}

.cp-val {
  font-family: var(--font-en-display);
  font-size: 72rpx;
  font-weight: 700;
  color: var(--gold-600);
}

.cp-info {
  margin-top: 16rpx;
}

.cp-label {
  font-size: 26rpx;
  color: var(--gold-500);
}

.cp-bar {
  height: 12rpx;
  background: var(--gold-100);
  border-radius: 6rpx;
  overflow: hidden;
  margin-top: 16rpx;
}

.cp-fill {
  height: 100%;
  background: linear-gradient(90deg, var(--gold-300), var(--gold-500));
  border-radius: 6rpx;
  transition: width 0.5s ease;
}

/* ---------- 时间线增强 ---------- */
.checklist-timeline {
  background: linear-gradient(135deg, var(--bg-card), var(--gold-50));
  border: 2rpx solid var(--gold-100);
  box-shadow: var(--shadow-md);
  border-radius: var(--radius-lg);
  padding: 40rpx;
}

.checklist-group {
  margin-bottom: 48rpx;
}

.checklist-group:last-child {
  margin-bottom: 0;
}

.checklist-group-title {
  display: flex;
  align-items: center;
  gap: 16rpx;
  font-size: 28rpx;
  font-weight: 600;
  color: var(--gold-800);
  margin-bottom: 24rpx;
  padding-bottom: 16rpx;
  border-bottom: 2rpx solid var(--gold-100);
}

.cl-dot {
  width: 16rpx;
  height: 16rpx;
  border-radius: 50%;
  background: var(--gold-400);
}

/* ---------- 清单项增强 ---------- */
.checklist-item {
  transition: all 0.2s ease;
}

.checklist-item:active {
  background: var(--gold-50);
  transform: translateX(8rpx);
}

.checklist-check {
  transition: all 0.2s ease;
}

.checklist-item.checked .checklist-check {
  background: linear-gradient(135deg, var(--gold-400), var(--gold-500));
  box-shadow: 0 4rpx 12rpx rgba(193, 154, 80, 0.2);
}

/* ---------- 阶段图标增强 ---------- */
.checklist-stage-icon {
  background: linear-gradient(135deg, var(--gold-100), var(--gold-200));
  box-shadow: var(--shadow-sm);
  transition: all 0.3s ease;
}

.checklist-stage-icon.stage-done {
  background: linear-gradient(135deg, var(--gold-400), var(--gold-500));
  box-shadow: var(--shadow-gold);
}

/* ---------- 提示卡片增强 ---------- */
.checklist-tip {
  background: linear-gradient(135deg, var(--gold-50), var(--bg-card));
  border: 2rpx solid var(--gold-100);
  border-radius: var(--radius-md);
}

