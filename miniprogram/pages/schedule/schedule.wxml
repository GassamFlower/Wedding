<nav-bar title="排期" show-back="{{false}}" />
<view class="page">
  <!-- 日历导航 -->
  <view class="cal-nav flex-between">
    <text class="cal-nav-btn" catchtap="goPrev">‹</text>
    <view class="cal-nav-title"><text>{{year}}年{{month}}月</text><text class="cal-today-btn" catchtap="goToday">今天</text></view>
    <text class="cal-nav-btn" catchtap="goNext">›</text>
  </view>
  <!-- 日历网格 -->
  <view class="cal-grid card">
    <view class="cal-weekdays flex-row">
      <text wx:for="{{['一','二','三','四','五','六','日']}}" wx:key="this" class="cal-weekday">{{item}}</text>
    </view>
    <view class="cal-days">
      <view wx:for="{{cells}}" wx:key="index" class="cal-cell {{item.isEmpty?'empty':''}} {{item.isToday?'today':''}} {{item.hasEvent?'has-event':''}}">
        <text class="cal-day-num">{{item.day || ''}}</text>
        <text wx:if="{{item.hasEvent}}" class="cal-dot"></text>
      </view>
    </view>
  </view>
  <!-- 婚礼列表 -->
  <view class="section-title"><view class="gold-dot"></view>本月婚礼</view>
  <view wx:for="{{weddings}}" wx:key="id" class="order-card card" catchtap="goDetail" data-id="{{item.id}}">
    <view class="order-header">
      <view class="order-avatar avatar avatar-{{item.avatarClass||1}}">{{item.client ? item.client[0] : '?'}}</view>
      <view class="order-info"><text class="order-name">{{item.client}}</text><text class="order-date">{{item.date}} · {{item.venue}}</text></view>
      <view class="order-tag tag tag-{{item.statusClass||'progress'}}">{{item.status || '筹备中'}}</view>
    </view>
  </view>
  <!-- 错误状态 -->
  <view wx:if="{{error && !loading}}" class="error-state">
    <view class="error-icon">⚠</view>
    <text class="error-text">{{errorMsg || '数据加载失败'}}</text>
    <button class="retry-btn" catchtap="loadData">重新加载</button>
  </view>

  <view wx:elif="{{!loading && !error && weddings.length===0}}" class="empty-state">本月暂无婚礼</view>
</view>

<!-- 登录弹窗 -->
<login-modal visible="{{showLoginModal}}" bind:success="onLoginSuccess" bind:close="onLoginClose" />
