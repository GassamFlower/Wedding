/* 线索列表 — 轻复古·奶油风 · 24rpx 基准 */

/* Tab 切换 */
.tab-scroll { white-space: nowrap; margin-bottom: 28rpx; }
.tab-row { display: inline-flex; gap: 16rpx; padding: 0 8rpx; }
.tab-item {
  padding: 12rpx 32rpx;
  border-radius: 999rpx;
  font-size: 26rpx;
  color: var(--text-secondary);
  background: var(--bg-card);
  border: 2rpx solid var(--border);
  cursor: pointer;
  white-space: nowrap;
}
.tab-active {
  background: var(--gold);
  color: var(--text-inverse);
  border-color: var(--gold);
}

/* 线索卡片 */
.lead-card {
  margin-bottom: 20rpx;
  padding: 28rpx 32rpx;
  cursor: pointer;
  position: relative;
  overflow: hidden;
}
.lead-card::before { display: none; }
.lead-overdue-bar {
  position: absolute;
  left: 0; top: 0; bottom: 0;
  width: 6rpx;
  background: var(--warning);
  border-radius: 0 4rpx 4rpx 0;
}

.lead-header { display: flex; align-items: flex-start; gap: 20rpx; }
.lead-avatar {
  width: 72rpx; height: 72rpx;
  border-radius: 50%;
  background: var(--gold-bg);
  display: flex;
  align-items: center;
  justify-content: center;
  font-size: 30rpx;
  font-weight: 600;
  color: var(--gold-dark);
  flex-shrink: 0;
}
.lead-main { flex: 1; min-width: 0; }
.lead-name-row { display: flex; align-items: center; gap: 16rpx; }
.lead-name { font-size: 28rpx; font-weight: 600; color: var(--text); }
.lead-phone { font-size: 24rpx; color: var(--text-muted); }
.lead-meta { font-size: 24rpx; color: var(--text-secondary); margin-top: 8rpx; overflow: hidden; text-overflow: ellipsis; white-space: nowrap; }

.lead-status {
  font-size: 22rpx; padding: 6rpx 20rpx; border-radius: 999rpx;
  flex-shrink: 0; font-weight: 500;
}
.status-pending { background: var(--error-light); color: var(--error); }
.status-done { background: var(--success-light); color: var(--success); }
.status-normal { background: var(--gold-bg); color: var(--gold-dark); }

.lead-footer { margin-top: 16rpx; padding-top: 16rpx; border-top: 2rpx solid var(--border); }
.lead-follow-time { font-size: 22rpx; color: var(--text-muted); }

/* 空状态 */
.empty-state { text-align: center; padding: 120rpx 40rpx; }
.empty-title { font-size: 32rpx; font-weight: 600; color: var(--text); display: block; }
.empty-desc { font-size: 26rpx; color: var(--text-muted); margin-top: 16rpx; display: block; }

.loading-state { padding: 40rpx; }

/* ═══ 增强样式 ═══ */
.tab-item {
  background: linear-gradient(135deg, var(--bg-card), var(--gold-50));
  border: 2rpx solid var(--gold-200);
  box-shadow: var(--shadow-sm);
}
.tab-item:active { transform: scale(0.95); }
.tab-active {
  background: linear-gradient(135deg, var(--gold-400), var(--gold-500));
  border-color: var(--gold-400);
  box-shadow: var(--shadow-gold);
  color: var(--text-inverse);
}

.lead-card {
  background: linear-gradient(135deg, var(--bg-card), var(--gold-50));
  border: 2rpx solid var(--gold-100);
  box-shadow: var(--shadow-md);
  border-radius: 32rpx;
}
.lead-card:active { transform: translateY(-4rpx); box-shadow: var(--shadow-lg); }
.lead-avatar {
  background: linear-gradient(135deg, var(--gold-200), var(--gold-400));
  box-shadow: var(--shadow-gold);
}
.lead-name { color: var(--gold-800); font-weight: 700; }
.lead-overdue-bar { background: linear-gradient(180deg, var(--warning), var(--warning)); }

.lead-status { font-weight: 600; }
.status-pending {
  background: linear-gradient(135deg, var(--error-light), var(--error-light));
  color: var(--error);
  border: 2rpx solid var(--error-light);
}
.status-done {
  background: linear-gradient(135deg, var(--success-light), var(--success-light));
  color: var(--success);
  border: 2rpx solid var(--success-light);
}
.status-normal {
  background: linear-gradient(135deg, var(--gold-100), var(--gold-200));
  color: var(--gold-700);
  border: 2rpx solid var(--gold-200);
}
