/* 个人中心 — 轻复古·奶油风 · 24rpx 基准 */

/* 头部区域 */
.profile-header {
  background: linear-gradient(135deg, var(--gold-400), var(--gold-500));
  padding: 48rpx 40rpx;
  border-radius: 32rpx;
  margin-bottom: 40rpx;
  box-shadow: var(--shadow-gold);
  position: relative;
  overflow: hidden;
}

.profile-header::before {
  content: '';
  position: absolute;
  top: -50%;
  right: -50%;
  width: 200%;
  height: 200%;
  background: radial-gradient(circle, rgba(255, 255, 255, 0.1) 0%, transparent 70%);
  animation: rotate 20s linear infinite;
}

.avatar-wrap {
  width: 120rpx;
  height: 120rpx;
  border-radius: 50%;
  background: var(--bg-card);
  display: flex;
  align-items: center;
  justify-content: center;
  margin-bottom: 24rpx;
  box-shadow: 0 8rpx 24rpx rgba(0, 0, 0, 0.1);
  position: relative;
  z-index: 1;
}

.avatar {
  width: 108rpx;
  height: 108rpx;
  border-radius: 50%;
  background: linear-gradient(135deg, var(--gold-200), var(--gold-400));
  display: flex;
  align-items: center;
  justify-content: center;
  font-size: 48rpx;
  font-weight: 700;
  color: var(--text-inverse);
}

.user-info {
  position: relative;
  z-index: 1;
}

.user-name,
.profile-name {
  font-size: 36rpx;
  font-weight: 700;
  color: var(--text-inverse);
  display: block;
  margin-bottom: 8rpx;
}

.user-role,
.profile-role {
  font-size: 26rpx;
  color: rgba(255, 255, 255, 0.8);
  display: block;
}

.profile-phone {
  font-size: 24rpx;
  color: rgba(255, 255, 255, 0.7);
  display: block;
  margin-top: 8rpx;
}

/* 统计卡片 */
.stats-card {
  background: linear-gradient(135deg, var(--bg-card), var(--gold-50));
  border: 2rpx solid var(--gold-100);
  box-shadow: var(--shadow-md);
  border-radius: 32rpx;
  padding: 32rpx;
  margin-bottom: 32rpx;
}

.stats-row {
  display: flex;
  justify-content: space-around;
  text-align: center;
}

.stat-item {
  flex: 1;
  padding: 16rpx;
}

.stat-num {
  font-family: var(--font-en-display);
  font-size: 40rpx;
  font-weight: 700;
  color: var(--gold-600);
  display: block;
}

.stat-label {
  font-size: 24rpx;
  color: var(--gold-500);
  margin-top: 8rpx;
  display: block;
}

/* 菜单列表 */
.menu-list {
  background: linear-gradient(135deg, var(--bg-card), var(--gold-50));
  border: 2rpx solid var(--gold-100);
  box-shadow: var(--shadow-md);
  border-radius: 32rpx;
  overflow: hidden;
}

.menu-item {
  display: flex;
  align-items: center;
  padding: 32rpx;
  border-bottom: 2rpx solid var(--gold-100);
  cursor: pointer;
  transition: all 0.2s ease;
}

.menu-item:last-child {
  border-bottom: none;
}

.menu-item:active {
  background: var(--gold-50);
  transform: translateX(8rpx);
}

.menu-icon {
  width: 48rpx;
  height: 48rpx;
  border-radius: 12rpx;
  background: linear-gradient(135deg, var(--gold-100), var(--gold-200));
  display: flex;
  align-items: center;
  justify-content: center;
  margin-right: 24rpx;
  color: var(--gold-700);
  font-size: 28rpx;
}

.menu-text {
  flex: 1;
  font-size: 28rpx;
  font-weight: 500;
  color: var(--gold-800);
}

.menu-arrow {
  font-size: 32rpx;
  color: var(--gold-400);
}

/* 退出按钮 */
.logout-btn {
  background: linear-gradient(135deg, var(--error-light), var(--error-light));
  color: var(--error);
  font-size: 28rpx;
  font-weight: 600;
  padding: 24rpx;
  border-radius: 999rpx;
  text-align: center;
  border: 2rpx solid var(--error-light);
  margin-top: 40rpx;
  cursor: pointer;
}

.logout-btn:active {
  transform: scale(0.97);
}

@keyframes rotate {
  from { transform: rotate(0deg); }
  to { transform: rotate(360deg); }
}

/* 功能入口网格 */
.profile-grid {
  display: flex;
  flex-wrap: wrap;
  gap: 24rpx;
  padding: 32rpx;
  background: linear-gradient(135deg, var(--bg-card), var(--gold-50));
  border: 2rpx solid var(--gold-100);
  box-shadow: var(--shadow-md);
  border-radius: 32rpx;
}

.profile-grid-item {
  flex: 1;
  min-width: calc(33.333% - 16rpx);
  display: flex;
  flex-direction: column;
  align-items: center;
  justify-content: center;
  padding: 24rpx 16rpx;
  background: var(--bg-card);
  border-radius: 24rpx;
  border: 2rpx solid var(--gold-100);
  transition: all 0.2s ease;
  cursor: pointer;
}

.profile-grid-item:active {
  transform: scale(0.96);
  background: var(--gold-50);
}

.profile-grid-icon {
  width: 56rpx;
  height: 56rpx;
  margin-bottom: 12rpx;
  color: var(--gold);
}

.profile-grid-label {
  font-size: 24rpx;
  color: var(--text-primary);
  font-weight: 500;
  text-align: center;
}

/* 统计行 */
.stat-row {
  display: flex;
  gap: 16rpx;
  margin-bottom: 24rpx;
}

.stat-card {
  flex: 1;
  background: var(--bg-card);
  border-radius: 24rpx;
  padding: 24rpx 16rpx;
  display: flex;
  flex-direction: column;
  align-items: center;
  justify-content: center;
  text-align: center;
  box-shadow: var(--shadow-card);
  border: 2rpx solid var(--gold-100);
}

.stat-num {
  font-size: 40rpx;
  font-weight: 700;
  color: var(--gold);
  display: block;
  letter-spacing: -0.6rpx;
  line-height: 1.3;
}

.stat-label {
  font-size: 22rpx;
  color: var(--text-secondary);
  display: block;
  margin-top: 8rpx;
}

/* 切换按钮 */
.btn-switch {
  display: flex;
  align-items: center;
  justify-content: center;
  background: linear-gradient(135deg, var(--gold-400), var(--gold-500));
  color: var(--text-inverse);
  font-size: 24rpx;
  font-weight: 600;
  padding: 16rpx 32rpx;
  border-radius: 999rpx;
  border: none;
  box-shadow: var(--shadow-btn);
  cursor: pointer;
  transition: all 0.2s ease;
  line-height: 1;
}

.btn-switch:active {
  transform: scale(0.96);
}
