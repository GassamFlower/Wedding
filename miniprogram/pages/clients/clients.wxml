<nav-bar title="客户管理" show-back="{{true}}" />
<view class="page">
  <!-- 搜索 -->
  <view class="search-bar-inline">
    <input class="search-input" placeholder="搜索客户名称..." value="{{keyword}}" bindinput="onSearchInput" />
  </view>
  <!-- 统计 -->
  <view class="stat-row">
    <view class="stat-card"><text class="stat-num">{{totalClients}}</text><text class="stat-label">全部客户</text></view>
    <view class="stat-card"><text class="stat-num">{{activeCount}}</text><text class="stat-label">进行中</text></view>
    <view class="stat-card"><text class="stat-num">{{doneCount}}</text><text class="stat-label">已完成</text></view>
  </view>
  <!-- Tab -->
  <view class="tabs">
    <view wx:for="{{['all','active','done']}}" wx:key="this" class="tab {{tab===item?'active':''}}" catchtap="switchTab" data-tab="{{item}}">
      <text>{{item==='all'?'全部':item==='active'?'进行中':'已完成'}}</text>
    </view>
  </view>

  <!-- 新建/编辑表单（内联，置顶显示） -->
  <view wx:if="{{showForm}}" class="form-inline">
    <view class="form-title">{{editingId ? '编辑客户' : '新建客户'}}</view>
    <view class="form-scroll-body">
      <view class="form-group"><text class="form-label">客户名称 *</text><input class="form-input" placeholder="如：张先生 & 李女士" value="{{formData.name}}" bindinput="onFormInput" data-field="name" /></view>
      <view class="form-row"><view class="form-group" style="flex:1;"><text class="form-label">手机号</text><input class="form-input" type="number" maxlength="11" placeholder="手机号" value="{{formData.phone}}" bindinput="onFormInput" data-field="phone" /></view>
      <view class="form-group" style="flex:1;"><text class="form-label">微信</text><input class="form-input" placeholder="微信号" value="{{formData.wechat}}" bindinput="onFormInput" data-field="wechat" /></view></view>
      <view class="form-group"><text class="form-label">备注</text><input class="form-input" placeholder="客户需求/偏好等" value="{{formData.remark}}" bindinput="onFormInput" data-field="remark" /></view>
    </view>
    <view class="form-btns"><button class="btn-cancel" catchtap="closeForm">取消</button><button class="btn-primary" catchtap="submitForm">{{editingId ? '保存' : '添加'}}</button></view>
  </view>

  <!-- 客户列表 -->
  <view wx:for="{{filtered || clients}}" wx:key="id" class="client-card card">
    <view class="client-header flex-row gap-12">
      <view class="avatar avatar-{{item.avatarClass||1}}">{{item.name ? item.name[0] : '?'}}</view>
      <view class="flex-1">
        <text class="client-name">{{item.name}}</text>
        <text class="client-info">{{item.phone || ''}} · {{item.venue || ''}}</text>
      </view>
      <view class="tag {{item.status==='done'?'tag--done':'tag--progress'}}">{{item.status==='done'?'已完成':'进行中'}}</view>
    </view>
    <view class="client-footer flex-between mt-8">
      <view class="client-stats">
        <text class="text-muted text-sm">¥{{item.amount}}</text>
        <text class="text-muted text-sm">{{item.date}}</text>
      </view>
      <view class="client-actions">
        <view class="action-btn action-edit" catchtap="openEdit" data-item="{{item}}">
          <view class="svg-icon icon-14 icon-edit-gold"></view>
          <text>编辑</text>
        </view>
        <view class="action-btn action-delete" catchtap="deleteClient" data-id="{{item.id}}" data-name="{{item.name}}">
          <view class="svg-icon icon-14 icon-delete-red"></view>
          <text>删除</text>
        </view>
      </view>
    </view>
  </view>
  <!-- 错误状态 -->
  <view wx:if="{{error && !loading}}" class="error-state">
    <view class="error-icon">⚠</view>
    <text class="error-text">{{errorMsg || '数据加载失败'}}</text>
    <button class="retry-btn" catchtap="loadData">重新加载</button>
  </view>

  <!-- 空状态 -->
  <view wx:elif="{{!loading && !error && clients.length===0}}" class="empty-state">
    <text>暂无客户</text>
    <text class="text-sm mt-8" catchtap="openCreate">点击添加客户</text>
  </view>

  <!-- FAB 新增按钮 -->
  <view wx:if="{{!showForm}}" class="fab-btn" catchtap="openCreate">
    <view class="fab-icon-wrap"><view class="svg-icon icon-16 icon-add-white"></view></view>
    <text class="fab-label">新增</text>
  </view>

  <!-- Loading -->
  <view wx:if="{{loading}}" class="loading-center"><view class="loading-spinner"></view><text>加载中...</text></view>
</view>

<!-- 登录弹窗 -->
<login-modal visible="{{showLoginModal}}" bind:success="onLoginSuccess" bind:close="onLoginClose" />
