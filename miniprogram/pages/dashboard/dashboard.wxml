<nav-bar title="大喜的日子" show-back="{{false}}" />
<view class="page">
  <!-- 搜索入口 -->
  <view class="search-bar" catchtap="goSearch">
    <view class="search-icon icon icon-search" style="width:36rpx;height:36rpx;"></view>
    <text class="search-placeholder">搜索订单、客户、道具...</text>
  </view>

  <!-- ═══ 三层信息架构 ═══ -->

  <!-- Layer 1: 待处理线索（最紧迫） -->
  <view wx:if="{{pendingLeads > 0}}" class="alert-card card-premium" catchtap="goLeads">
    <view class="alert-bar"></view>
    <view class="alert-body">
      <view class="alert-left">
        <view class="alert-icon">!</view>
        <text class="alert-title">待处理线索</text>
      </view>
      <view class="alert-right">
        <text class="alert-count">{{pendingLeads}}条待跟进</text>
        <text wx:if="{{overdueLeads > 0}}" class="alert-overdue">（{{overdueLeads}}条超24h未处理）</text>
      </view>
    </view>
    <view class="alert-arrow">→</view>
  </view>

  <!-- Layer 2: 本周婚礼 + 待收尾款 -->
  <view class="insight-row">
    <view class="insight-card card-premium" catchtap="goSchedule">
      <view class="insight-icon-wrap" style="background:linear-gradient(135deg,var(--gold),var(--gold-mid));">
        <view class="icon icon-ring" style="width:36rpx;height:36rpx;color:#fff;"></view>
      </view>
      <view class="insight-info">
        <text class="insight-value">{{activeOrders}}场</text>
        <text class="insight-label">进行中婚礼</text>
      </view>
    </view>
    <view class="insight-card card-premium" catchtap="goContracts">
      <view class="insight-icon-wrap" style="background:linear-gradient(135deg,var(--gold-mid),var(--gold-dark));">
        <view class="icon icon-budget" style="width:36rpx;height:36rpx;color:#fff;"></view>
      </view>
      <view class="insight-info">
        <text class="insight-value" style="{{pendingBalance > 0 ? 'color:var(--gold-dark);' : ''}}">{{pendingBalance > 0 ? '¥'+pendingBalance : '已结清'}}</text>
        <text class="insight-label">{{pendingBalanceCount > 0 ? '待收尾款('+pendingBalanceCount+'单)' : '合约状态'}}</text>
      </view>
    </view>
  </view>

  <!-- Layer 3: 本月统计 -->
  <view class="stat-row">
    <view class="stat-item">
      <text class="stat-num">{{monthOrders}}</text>
      <text class="stat-label">本月接单</text>
    </view>
    <view class="stat-item">
      <text class="stat-num">{{activeOrders}}</text>
      <text class="stat-label">进行中</text>
    </view>
    <view class="stat-item">
      <text class="stat-num">¥{{monthIncome}}</text>
      <text class="stat-label">本月收入</text>
    </view>
  </view>

  <!-- 快捷操作（+新线索） -->
  <view class="quick-actions">
    <view class="action-btn" catchtap="goLeads">
      <view class="action-icon-wrap">
        <view class="svg-icon icon-20 icon-add-gold"></view>
      </view>
      <text class="action-label">新线索</text>
    </view>
    <view class="action-btn" catchtap="goNewOrder">
      <view class="action-icon-wrap">
        <view class="svg-icon icon-20 icon-doc-gold"></view>
      </view>
      <text class="action-label">新订单</text>
    </view>
    <view class="action-btn" catchtap="onNav" data-page="/pages/props/props">
      <view class="action-icon-wrap">
        <view class="svg-icon icon-20 icon-box-gold"></view>
      </view>
      <text class="action-label">道具</text>
    </view>
    <view class="action-btn" catchtap="onNav" data-page="/pages/profile/profile">
      <view class="action-icon-wrap">
        <view class="svg-icon icon-20 icon-user-gold"></view>
      </view>
      <text class="action-label">个人</text>
    </view>
  </view>

  <!-- 近期婚礼 -->
  <view class="section-title"><view class="gold-bar"></view>近期婚礼</view>
  <view wx:if="{{orders.length===0 && !loading}}" class="empty-state">
      <view wx:if="{{orders.length===0 && !loading}}" class="empty-wrap">
    <view class="empty-illustration-gift">
      <view class="gift-box"></view><view class="gift-lid"></view><view class="gift-ribbon"></view><view class="gift-bow"></view>
    </view>
    <text class="empty-title">你的婚礼订单还在路上</text>
    <text class="empty-desc">点击下方按钮，开始创建第一场婚礼订单吧</text>
    <button class="empty-cta" catchtap="goNewOrder">新建订单 →</button>
  </view>
  </view>
  <view wx:for="{{orders}}" wx:key="id" class="order-card card-premium" catchtap="goOrder" data-id="{{item.id}}">
    <view class="order-header">
      <view class="order-avatar avatar avatar-{{item.avatarClass||1}}">{{item.short}}</view>
      <view class="order-info">
        <text class="order-name">{{item.client}}</text>
        <text class="order-date">{{item.date}} · {{item.venue}}</text>
      </view>
      <view class="order-tag tag tag-{{item.statusClass||'progress'}}">{{item.status}}</view>
    </view>
    <view class="order-tags">
      <text wx:for="{{item.tags}}" wx:key="this" class="order-tag-item">{{item}}</text>
    </view>
    <view class="order-footer">
      <text class="order-amount">¥{{item.amount}}</text>
    </view>
  </view>
  <!-- 待办事项 -->
  <view class="section-title" style="margin-top:16rpx;"><view class="gold-bar"></view>待办事项</view>
  <view wx:for="{{todos}}" wx:key="id" class="todo-item {{item.done?'todo-done':''}}" catchtap="toggleTodo" data-id="{{item.id}}">
    <view class="todo-check {{item.done?'checked':''}}">
      <view wx:if="{{item.done}}" class="svg-icon icon-12 icon-check-white"></view>
    </view>
    <view class="todo-content">
      <text class="todo-text">{{item.text}}</text>
      <text class="todo-time">{{item.time}} · {{item.priority}}优先级</text>
    </view>
  </view>
  <!-- 底部加载 -->
    <view wx:if="{{loading}}" class="skeleton-card">
    <view class="skeleton-cover skeleton-cover-sm skeleton-shimmer"></view>
    <view class="skeleton-body">
      <view class="skeleton-line w-70 skeleton-shimmer"></view>
      <view class="skeleton-line w-50 skeleton-shimmer"></view>
      <view class="skeleton-line w-60 skeleton-shimmer"></view>
    </view>
  </view>
  <view wx:if="{{loading}}" class="skeleton-card" style="margin-top:20rpx;">
    <view class="skeleton-cover skeleton-cover-sm skeleton-shimmer"></view>
    <view class="skeleton-body">
      <view class="skeleton-line w-60 skeleton-shimmer"></view>
      <view class="skeleton-line w-40 skeleton-shimmer"></view>
    </view>
  </view>
</view>
