<nav-bar title="预算计算器" show-back="{{true}}" />
<view class="page budget-page">
  <!-- 总预算展示 -->
  <view class="budget-total-card">
    <text class="budget-total-label">预估总预算</text>
    <text class="budget-total-num">¥{{total}}</text>
    <view class="budget-level-tag" style="background:{{budgetLevelColor}};"><text>{{budgetLevel}}</text></view>
  </view>

  <!-- 预算参考条 -->
  <view class="card--premium" style="padding:24rpx;">
    <text class="text-xs text-muted" style="display:block;margin-bottom:12rpx;">预算区间参考</text>
    <view class="budget-bars">
      <view wx:for="{{referenceBars}}" wx:key="label" class="budget-bar-item" style="flex:1;">
        <view class="budget-bar" style="background:{{item.color}};height:{{total>=item.min?48:24}}rpx;opacity:{{total>=item.min?1:0.3}};"></view>
        <text class="budget-bar-label">{{item.label}}</text>
      </view>
    </view>
  </view>

  <!-- 各项预算输入 -->
  <view class="card--premium">
    <view class="section-title"><view class="gold-bar"></view><view class="icon icon-budget" style="width:26rpx;height:26rpx;color:var(--gold);vertical-align:-4rpx;margin-right:10rpx;"></view>费用分配</view>
    <view wx:for="{{categories}}" wx:key="key" class="budget-category">
      <view class="flex-between" style="margin-bottom:8rpx;">
        <view class="flex-row gap-8">
          <view class="icon icon-{{item.icon}}" style="width:40rpx;height:40rpx;"></view>
          <text class="text-sm font-600">{{item.label}}</text>
        </view>
        <input class="budget-input" type="number" value="{{item.value}}" data-key="{{item.key}}" bindinput="onInputChange" />
      </view>
      <slider
        value="{{item.value}}"
        min="{{item.min}}"
        max="{{item.max}}"
        step="{{item.step}}"
        backgroundColor="rgba(0,0,0,0.06)"
        activeColor="{{item.color}}"
        blockSize="16"
        data-key="{{item.key}}"
        bindchange="onSliderChange"
        show-value="{{false}}"
      />
      <view class="flex-between">
        <text class="text-xs text-muted">¥{{item.min}}</text>
        <text class="text-xs text-muted">¥{{item.max}}</text>
      </view>
    </view>
  </view>

  <!-- 占比分析 -->
  <view class="card--premium">
    <view class="section-title"><view class="gold-bar"></view><view class="icon icon-target" style="width:26rpx;height:26rpx;color:var(--gold);vertical-align:-4rpx;margin-right:10rpx;"></view>费用占比</view>
    <view wx:for="{{categories}}" wx:key="key" class="budget-pie-item">
      <view class="flex-row gap-8" style="align-items:center;">
        <view class="budget-dot" style="background:{{item.color}};"></view>
        <text class="text-sm" style="flex:1;">{{item.label}}</text>
        <text class="text-sm font-600" style="color:{{item.color}};">¥{{item.value}}</text>
        <text class="text-xs text-muted">{{percentages[index].pct}}%</text>
      </view>
      <view class="progress-bar" style="height:12rpx;margin-top:12rpx;">
        <view class="progress-bar-fill" style="{{percentages[index].style}};background:{{item.color}};"></view>
      </view>
    </view>
  </view>

  <!-- 底部操作 -->
  <view class="budget-actions">
    <button class="result-btn-primary" catchtap="goContact">AI 设计同款方案</button>
    <button class="result-btn-secondary" catchtap="resetBudget" style="margin-top:16rpx;">重置预算</button>
  </view>
  <view class="text-center" style="margin:32rpx 0 80rpx;">
    <text class="text-xs text-muted">以上预算为估算参考，实际价格以策划方案为准</text>
  </view>
</view>