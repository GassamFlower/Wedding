/* 预算计算器 — 轻复古·奶油风 · 24rpx 基准 */

.budget-page {
  min-height: 100vh;
  padding: 24rpx 32rpx 80rpx;
  background: var(--bg);
  box-sizing: border-box;
}

/* ===== 总预算卡片 ===== */
.budget-total-card {
  background: linear-gradient(135deg, var(--gold-400), var(--gold-500));
  border-radius: var(--radius-lg);
  padding: 48rpx 40rpx;
  text-align: center;
  margin-bottom: 32rpx;
  box-shadow: 0 8rpx 32rpx rgba(193, 154, 80, 0.25);
  position: relative;
}

.budget-total-label {
  display: block;
  font-size: 26rpx;
  color: rgba(255, 255, 255, 0.85);
  margin-bottom: 16rpx;
  font-weight: 500;
}

.budget-total-num {
  display: block;
  font-size: 64rpx;
  font-weight: 700;
  color: var(--text-inverse);
  font-family: var(--font-en-display, 'Georgia', serif);
  margin-bottom: 20rpx;
}

.budget-level-tag {
  display: inline-block;
  padding: 8rpx 28rpx;
  border-radius: 999rpx;
  font-size: 24rpx;
  font-weight: 600;
  color: var(--gold-700);
  background: rgba(255, 255, 255, 0.9);
}

/* ===== 预算参考条 ===== */
.budget-bars {
  display: flex;
  gap: 12rpx;
  align-items: flex-end;
}

.budget-bar-item {
  flex: 1;
  display: flex;
  flex-direction: column;
  align-items: center;
  gap: 10rpx;
}

.budget-bar {
  width: 100%;
  border-radius: 8rpx;
  transition: height 0.3s ease, opacity 0.3s ease;
}

.budget-bar-label {
  font-size: 18rpx;
  color: var(--text-secondary);
  text-align: center;
  line-height: 1.3;
}

/* ===== 费用分配 ===== */
.budget-category {
  padding: 28rpx 0;
  border-bottom: 2rpx solid var(--gold-100);
}

.budget-category:last-child {
  border-bottom: none;
}

.budget-input {
  width: 160rpx;
  height: 56rpx;
  text-align: right;
  font-size: 30rpx;
  font-weight: 700;
  color: var(--gold-700);
  background: var(--gold-50);
  border: 2rpx solid var(--gold-200);
  border-radius: var(--radius);
  padding: 0 16rpx;
  box-sizing: border-box;
}

/* ===== 费用占比 ===== */
.budget-pie-item {
  padding: 20rpx 0;
  border-bottom: 2rpx solid rgba(0, 0, 0, 0.03);
}

.budget-pie-item:last-child {
  border-bottom: none;
}

.budget-dot {
  width: 16rpx;
  height: 16rpx;
  border-radius: 50%;
  flex-shrink: 0;
}

/* ===== 底部操作 ===== */
.budget-actions {
  margin-top: 40rpx;
  padding-bottom: 20rpx;
}

.result-btn-primary,
.result-btn-secondary {
  width: 100%;
  margin: 0;
  padding: 0;
  line-height: 1;
  font-size: inherit;
  font-weight: inherit;
  color: inherit;
  background: transparent;
  border: none;
  border-radius: 0;
}

.result-btn-primary::after,
.result-btn-secondary::after {
  display: none;
}

.result-btn-primary {
  display: flex;
  align-items: center;
  justify-content: center;
  height: 88rpx;
  background: linear-gradient(135deg, var(--gold-400), var(--gold-500));
  color: var(--text-inverse);
  font-size: 30rpx;
  font-weight: 600;
  border-radius: 999rpx;
  box-shadow: 0 6rpx 24rpx rgba(193, 154, 80, 0.3);
}

.result-btn-primary:active {
  opacity: 0.9;
  transform: scale(0.97);
}

.result-btn-secondary {
  display: flex;
  align-items: center;
  justify-content: center;
  height: 80rpx;
  background: var(--bg-card);
  color: var(--gold-600);
  font-size: 28rpx;
  font-weight: 500;
  border-radius: 999rpx;
  border: 2rpx solid var(--gold-200);
  margin-top: 16rpx;
}

.result-btn-secondary:active {
  background: var(--gold-50);
}
