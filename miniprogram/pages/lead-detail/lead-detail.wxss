/* 线索详情 — 轻复古·奶油风 · 24rpx 基准 */

/* 详情页区块 */
.detail-section { margin-bottom: 32rpx; }
.detail-header {
  display: flex; align-items: center; gap: 24rpx;
  padding-bottom: 32rpx; margin-bottom: 16rpx;
  border-bottom: 2rpx solid var(--border);
}
.detail-avatar {
  width: 88rpx; height: 88rpx;
  border-radius: 50%;
  background: var(--gold-bg);
  display: flex; align-items: center; justify-content: center;
  font-size: 36rpx; font-weight: 600; color: var(--gold-dark);
  flex-shrink: 0;
}
.detail-name { font-size: 32rpx; font-weight: 600; display: block; }
.detail-phone { font-size: 26rpx; color: var(--text-muted); margin-top: 4rpx; display: block; }
.call-btn {
  margin-left: auto; flex-shrink: 0;
  padding: 16rpx 32rpx; border-radius: 999rpx;
  background: var(--gold-bg); color: var(--gold-dark);
  font-size: 24rpx; font-weight: 600; border: none; cursor: pointer;
  display: flex;
  align-items: center;
  justify-content: center;
  line-height: 1;
}

/* 信息行 */
.info-row { display: flex; justify-content: space-between; padding: 20rpx 0; border-bottom: 2rpx solid rgba(0,0,0,0.03); }
.info-label { font-size: 26rpx; color: var(--text-muted); flex-shrink: 0; }
.info-value { font-size: 26rpx; color: var(--text); text-align: right; }

/* 状态 Picker */
.status-picker-row { display: flex; align-items: center; gap: 16rpx; padding: 24rpx 0; }
.status-picker-label { font-size: 26rpx; color: var(--text-muted); }
.status-picker { flex: 1; }

/* 跟进时间线 */
.timeline-list { margin-top: 16rpx; }
.timeline-item { display: flex; gap: 20rpx; padding-bottom: 24rpx; }
.timeline-dot {
  width: 16rpx; height: 16rpx; border-radius: 50%;
  background: var(--gold); margin-top: 10rpx; flex-shrink: 0;
}
.timeline-body { flex: 1; }
.timeline-text { font-size: 26rpx; color: var(--text); line-height: 1.6; }
.timeline-time { font-size: 22rpx; color: var(--text-muted); margin-top: 4rpx; }

/* 备注输入 */
.note-input-area { padding: 24rpx 0; }
.note-input {
  width: 100%; border: 2rpx solid var(--border);
  border-radius: 24rpx; padding: 20rpx 28rpx;
  font-size: 26rpx; min-height: 120rpx; background: var(--bg-card);
}
.note-btn { margin-top: 20rpx; }

/* 底部操作 */
.footer-actions {
  position: sticky; bottom: 0;
  display: flex; gap: 20rpx;
  padding: 28rpx 0; background: var(--bg);
}
.footer-actions .btn-gold { flex: 1; }
.footer-actions .btn-outline { flex: 1; }

/* 按钮 */
.btn-gold {
  background: linear-gradient(135deg, var(--gold), var(--gold-mid));
  color: var(--text-inverse); font-size: 28rpx; font-weight: 600;
  padding: 24rpx; border-radius: 999rpx; text-align: center;
  border: none; cursor: pointer; display: block;
}
.btn-outline {
  background: var(--bg-card); color: var(--gold-dark);
  font-size: 26rpx; font-weight: 600; padding: 24rpx;
  border-radius: 999rpx; text-align: center;
  border: 2rpx solid var(--gold); cursor: pointer; display: block;
}

/* ═══ 增强样式 ═══ */
.detail-section {
  background: linear-gradient(135deg, var(--bg-card), var(--gold-50));
  border: 2rpx solid var(--gold-100);
  box-shadow: var(--shadow-md);
  border-radius: 32rpx;
  padding: 32rpx;
}

.detail-avatar {
  background: linear-gradient(135deg, var(--gold-200), var(--gold-400));
  box-shadow: var(--shadow-gold);
}

.detail-name {
  color: var(--gold-800);
  font-weight: 700;
}

.call-btn {
  background: linear-gradient(135deg, var(--gold-400), var(--gold-500));
  color: var(--text-inverse);
  box-shadow: var(--shadow-gold);
}

.call-btn:active {
  transform: scale(0.95);
  box-shadow: 0 4rpx 16rpx rgba(193, 154, 80, 0.3);
}

.timeline-dot {
  background: linear-gradient(135deg, var(--gold-400), var(--gold-500));
  box-shadow: var(--shadow-gold);
}

.note-input {
  background: linear-gradient(135deg, var(--gold-50), var(--bg-card));
  border: 3rpx solid var(--gold-200);
}

.note-input:focus {
  border-color: var(--gold-400);
  background: var(--bg-card);
  box-shadow: 0 0 0 6rpx rgba(193, 154, 80, 0.1);
}

.btn-gold {
  background: linear-gradient(135deg, var(--gold-400), var(--gold-500));
  box-shadow: var(--shadow-gold);
  position: relative;
  overflow: hidden;
}

.btn-gold::after {
  content: '';
  position: absolute;
  top: 0;
  left: -100%;
  width: 100%;
  height: 100%;
  background: linear-gradient(90deg, transparent, rgba(255, 255, 255, 0.2), transparent);
  animation: shimmerSlide 3s ease-in-out infinite;
}

.btn-gold:active {
  transform: scale(0.97);
  box-shadow: 0 4rpx 16rpx rgba(193, 154, 80, 0.3);
}

.btn-outline {
  background: linear-gradient(135deg, var(--bg-card), var(--gold-50));
  border: 2rpx solid var(--gold-200);
  color: var(--gold-700);
}

.btn-outline:active {
  background: var(--gold-50);
  transform: scale(0.97);
}
