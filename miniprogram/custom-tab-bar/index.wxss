/* ═══════════════════════════════════════════════
   ENHANCED TAB BAR — Design Canvas Migration
   从设计画布迁移的底部标签栏增强样式
   ═══════════════════════════════════════════════ */

/* ---------- 玻璃态效果标签栏 ---------- */
.tab-bar-glass {
  background: rgba(255, 255, 255, 0.85);
  backdrop-filter: blur(12px);
  -webkit-backdrop-filter: blur(12px);
  border-top: 1px solid rgba(193, 154, 80, 0.1);
}

/* ---------- 渐变背景标签栏 ---------- */
.tab-bar-gradient {
  background: linear-gradient(180deg, var(--gold-50), var(--bg-card));
  border-top: 1px solid var(--gold-100);
}

/* ---------- 活跃标签指示器增强 ---------- */
.tab-indicator-enhanced {
  position: absolute;
  top: -1px;
  left: 50%;
  transform: translateX(-50%);
  width: 24px;
  height: 2px;
  background: var(--gold-400);
  border-radius: 1px;
  opacity: 0;
  transition: all 0.3s ease;
}

.tab-item.active .tab-indicator-enhanced {
  opacity: 1;
}

/* ---------- 标签图标脉冲动画 ---------- */
.tab-item.active .tab-icon-pulse {
  animation: tabIconPulse 2s ease-in-out infinite;
}

@keyframes tabIconPulse {
  0%, 100% { transform: scale(1); }
  50% { transform: scale(1.05); }
}

/* ---------- 标签文字增强 ---------- */
.tab-label-enhanced {
  font-size: 10px;
  font-weight: 600;
  letter-spacing: 0.5px;
  margin-top: 2px;
}

.tab-item.active .tab-label-enhanced {
  color: var(--gold-500);
}

/* ---------- 徽章样式 ---------- */
.tab-badge {
  position: absolute;
  top: 4px;
  right: 50%;
  transform: translateX(18px);
  min-width: 16px;
  height: 16px;
  padding: 0 4px;
  background: var(--error);
  color: white;
  font-size: 10px;
  font-weight: 600;
  border-radius: 8px;
  display: flex;
  align-items: center;
  justify-content: center;
}

.tab-badge-dot {
  width: 6px;
  height: 6px;
  background: var(--error);
  border-radius: 50%;
  position: absolute;
  top: 6px;
  right: 50%;
  transform: translateX(12px);
}

/* ---------- 安全区域增强 ---------- */
.tab-bar-safe-enhanced {
  height: env(safe-area-inset-bottom, 0);
  background: linear-gradient(180deg, transparent, var(--gold-50));
}

