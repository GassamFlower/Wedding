.tab-bar-wrap { position:fixed; bottom:0; left:0; right:0; z-index:90; }
.tab-bar-inner { display:flex; background:#FBF7F0; border-top:1px solid #E8D5A8; padding:8px 0 0; position:relative; }
.tab-item { flex:1; display:flex; flex-direction:column; align-items:center; padding:2px 0 6px; cursor:pointer; color:rgba(0,0,0,0.35); transition:color .25s; position:relative; -webkit-tap-highlight-color:transparent; }
.tab-item:active { transform:scale(0.92); transition:transform .1s; }

/* Active tab */
.tab-item.active { color:#C19A50; }
.tab-item.active .tab-icon-wrap::after { opacity:1; transform:scale(1); }
.tab-item.active .tab-icon { animation:tabBounce .4s cubic-bezier(.34,1.56,.64,1) both; }
.tab-item.active .tab-indicator { opacity:1; transform:scaleX(1); }

/* Icon wrapper with active circle bg */
.tab-icon-wrap { position:relative; width:28px; height:28px; display:flex; align-items:center; justify-content:center; margin-bottom:2px; }
.tab-icon-wrap::after { content:""; position:absolute; inset:0; border-radius:50%; background:rgba(193,154,80,0.12); opacity:0; transform:scale(0.5); transition:all .3s cubic-bezier(.34,1.56,.64,1); }

.tab-icon { width:22px; height:22px; background-size:contain; background-repeat:no-repeat; background-position:center; position:relative; z-index:1; transition:transform .2s; }

.tab-label { font-size:9px; font-weight:500; letter-spacing:.1px; }

/* Gold indicator bar */
.tab-indicator { position:absolute; bottom:0; left:20%; right:20%; margin:0 auto; height:3px; background:linear-gradient(90deg,transparent,#C19A50 30%,#D4B87C 50%,#C19A50 70%,transparent); border-radius:3px 3px 0 0; opacity:0; transform:scaleX(0.3); transition:all .35s cubic-bezier(.34,1.56,.64,1); }

.tab-bar-safe { height:env(safe-area-inset-bottom,0); background:#FBF7F0; }

/* Bounce animation */
@keyframes tabBounce { 0%{transform:scale(1)} 30%{transform:scale(1.18)} 60%{transform:scale(0.92)} 100%{transform:scale(1)} }

