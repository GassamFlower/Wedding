/* ===== Icon Color Themes ===== */
/* Gold/sand accent */
.icon-ring, .icon-wedding, .icon-star, .icon-gift, .icon-celebration, .icon-crown { color: var(--gold); }
/* Blush/rose - romance */
.icon-heart { color: var(--gold); }
.icon-heart-o, .icon-flower, .icon-rose { color: var(--gold); }
/* Warm taupe - venue/location */
.icon-box, .icon-package, .icon-location, .icon-hotel, .icon-building, .icon-handshake { color: var(--text-second); }
/* Golden accent - alerts */
.icon-warning, .icon-light, .icon-lightbulb, .icon-hourglass { color: var(--gold-dark); }
/* Accent */
.icon-sparkles { color: var(--gold); }
/* FAQ & form */
.icon-help, .icon-minus, .icon-add { color: var(--gold); }
.icon-edit { color: var(--text-second); }
.icon-send { color: var(--gold); }
