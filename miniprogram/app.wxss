/* ═══════════════════════════════════════════════
   ANIMATION SYSTEM — Cream Style Motion
   轻复古·奶油风动画系统
   ═══════════════════════════════════════════════ */

/* ---------- Keyframes ---------- */
@keyframes fadeInUp {
  from { opacity: 0; transform: translateY(40rpx); }
  to { opacity: 1; transform: translateY(0); }
}

@keyframes float {
  0%, 100% { transform: translateY(0) rotate(0deg); }
  50% { transform: translateY(-20rpx) rotate(2deg); }
}

@keyframes pulse {
  0%, 100% { transform: scale(1); opacity: 1; }
  50% { transform: scale(1.05); opacity: 0.8; }
}

@keyframes watercolorFlow {
  0% { transform: translate(0, 0) rotate(0deg); opacity: 0.6; }
  50% { transform: translate(20rpx, -20rpx) rotate(5deg); opacity: 0.8; }
  100% { transform: translate(0, 0) rotate(0deg); opacity: 0.6; }
}

@keyframes gentleBounce {
  0%, 100% { transform: translateY(0); }
  50% { transform: translateY(-10rpx); }
}

@keyframes fadeInScale {
  from { opacity: 0; transform: scale(0.95); }
  to { opacity: 1; transform: scale(1); }
}

@keyframes slideInRight {
  from { opacity: 0; transform: translateX(40rpx); }
  to { opacity: 1; transform: translateX(0); }
}

@keyframes slideInLeft {
  from { opacity: 0; transform: translateX(-40rpx); }
  to { opacity: 1; transform: translateX(0); }
}

@keyframes bubbleIn {
  from { opacity: 0; transform: translateY(20rpx); }
  to { opacity: 1; transform: translateY(0); }
}

@keyframes spin {
  to { transform: rotate(360deg); }
}

@keyframes shimmer {
  0% { background-position: -200% center; }
  100% { background-position: 200% center; }
}

@keyframes shimmerSlide {
  0% { transform: translateX(-100%); }
  100% { transform: translateX(100%); }
}

@keyframes progressFill {
  from { width: 0; }
}

/* ---------- Animation Utility Classes ---------- */
.anim-fade-in-up { animation: fadeInUp 0.5s ease-out; }
.anim-fade-in-scale { animation: fadeInScale 0.4s ease-out; }
.anim-slide-in-right { animation: slideInRight 0.4s ease-out; }
.anim-slide-in-left { animation: slideInLeft 0.4s ease-out; }
.anim-bubble-in { animation: bubbleIn 0.35s ease-out; }
.anim-float { animation: float 12s ease-in-out infinite; }
.anim-pulse { animation: pulse 2s ease-in-out infinite; }
.anim-gentle-bounce { animation: gentleBounce 2s ease-in-out infinite; }

/* Staggered animation delays */
.anim-delay-1 { animation-delay: 0.1s; }
.anim-delay-2 { animation-delay: 0.2s; }
.anim-delay-3 { animation-delay: 0.3s; }
.anim-delay-4 { animation-delay: 0.4s; }
.anim-delay-5 { animation-delay: 0.5s; }

/* ═══════════════════════════════════════════════
   CREAM TEXTURE BACKGROUNDS
   奶油风纹理背景装饰系统
   ═══════════════════════════════════════════════ */

/* ---------- Page Background with Cream Wash ---------- */
.page-watercolor {
  position: relative;
  background: var(--gradient-warm);
}

.page-watercolor::before {
  content: '';
  position: fixed;
  top: 0;
  left: 0;
  right: 0;
  bottom: 0;
  background:
    radial-gradient(ellipse at 20% 30%, rgba(212, 175, 55, 0.04) 0%, transparent 50%),
    radial-gradient(ellipse at 80% 70%, rgba(245, 230, 200, 0.06) 0%, transparent 50%),
    radial-gradient(ellipse at 40% 80%, rgba(255, 255, 255, 0.5) 0%, transparent 50%);
  pointer-events: none;
  z-index: 0;
}

/* ---------- Cream Splash Decorations ---------- */
.watercolor-splash {
  position: absolute;
  border-radius: 50%;
  pointer-events: none;
  z-index: 0;
}

.watercolor-splash-gold {
  background: radial-gradient(circle, rgba(212, 175, 55, 0.06) 0%, transparent 70%);
}

.watercolor-splash-cream {
  background: radial-gradient(circle, rgba(245, 230, 200, 0.08) 0%, transparent 70%);
}

.watercolor-splash-white {
  background: radial-gradient(circle, rgba(255, 255, 255, 0.4) 0%, transparent 70%);
}

/* ---------- Cream Blob Positions ---------- */
.watercolor-blob-top-right {
  top: -160rpx;
  right: -120rpx;
  width: 400rpx;
  height: 400rpx;
}

.watercolor-blob-bottom-left {
  bottom: -80rpx;
  left: -80rpx;
  width: 320rpx;
  height: 320rpx;
}

.watercolor-blob-center-left {
  top: 50%;
  left: -120rpx;
  width: 280rpx;
  height: 280rpx;
}

/* ═══════════════════════════════════════════════
   GLASS MORPHISM SYSTEM
   玻璃态效果系统 — 轻复古·奶油风
   ═══════════════════════════════════════════════ */

.glass {
  background: var(--glass-bg);
  backdrop-filter: blur(40rpx);
  -webkit-backdrop-filter: blur(40rpx);
  border: 2rpx solid rgba(245, 230, 200, 0.3);
}

.glass-light {
  background: rgba(255, 255, 255, 0.6);
  backdrop-filter: blur(32rpx);
  -webkit-backdrop-filter: blur(32rpx);
  border: 2rpx solid rgba(245, 230, 200, 0.2);
}

.glass-strong {
  background: rgba(255, 255, 255, 0.85);
  backdrop-filter: blur(48rpx);
  -webkit-backdrop-filter: blur(48rpx);
  border: 2rpx solid rgba(245, 230, 200, 0.4);
}

.glass-gold {
  background: rgba(255, 249, 242, 0.85);
  backdrop-filter: blur(40rpx);
  -webkit-backdrop-filter: blur(40rpx);
  border: 2rpx solid rgba(212, 175, 55, 0.15);
}

/* ═══════════════════════════════════════════════
   ENHANCED CARD SYSTEM
   增强卡片系统 — 从画布迁移
   ═══════════════════════════════════════════════ */

/* ---------- Card with Gradient Border ---------- */
.card-gradient-border {
  position: relative;
  background: var(--bg-card);
  border-radius: var(--radius-lg);
  padding: 32rpx;
  box-shadow: var(--shadow-card);
  border: 2rpx solid var(--border-light);
}

.card-gradient-border::before {
  content: '';
  position: absolute;
  top: 0;
  left: 0;
  right: 0;
  height: 4rpx;
  background: var(--gradient-gold);
  border-radius: var(--radius-lg) var(--radius-lg) 0 0;
}

/* ---------- Card with Hover Lift Effect ---------- */
.card-lift {
  transition: transform 0.3s ease, box-shadow 0.3s ease;
}

.card-lift:active {
  transform: translateY(-4rpx);
  box-shadow: var(--shadow-hover);
}

/* ---------- Premium Card with Inner Glow ---------- */
.card-premium-glow {
  background: var(--bg-card);
  border-radius: var(--radius-lg);
  padding: 40rpx;
  box-shadow: var(--shadow-hover);
  position: relative;
  overflow: hidden;
  border: 2rpx solid var(--border-light);
}

.card-premium-glow::after {
  content: '';
  position: absolute;
  top: -50%;
  left: -50%;
  width: 200%;
  height: 200%;
  background: radial-gradient(circle at center, rgba(212, 175, 55, 0.04) 0%, transparent 50%);
  pointer-events: none;
}

/* ---------- Stat Card Variants ---------- */
.stat-card-gold {
  background: var(--gradient-warm);
  border: 2rpx solid var(--gold-light);
  border-radius: var(--radius-lg);
  padding: 32rpx;
  box-shadow: var(--shadow-card);
}

.stat-card-pink {
  background: linear-gradient(135deg, var(--bg-card), var(--warning-light));
  border: 2rpx solid var(--warning-light);
  border-radius: var(--radius-lg);
  padding: 32rpx;
  box-shadow: var(--shadow-card);
}

.stat-card-green {
  background: linear-gradient(135deg, var(--bg-card), var(--success-light));
  border: 2rpx solid var(--success-light);
  border-radius: var(--radius-lg);
  padding: 32rpx;
  box-shadow: var(--shadow-card);
}

.stat-card-blue {
  background: linear-gradient(135deg, var(--bg-card), var(--info-light));
  border: 2rpx solid var(--info-light);
  border-radius: var(--radius-lg);
  padding: 32rpx;
  box-shadow: var(--shadow-card);
}

/* ---------- Feature Card ---------- */
.feature-card {
  background: var(--gradient-warm);
  border-radius: var(--radius-xl);
  padding: 48rpx 32rpx;
  text-align: center;
  border: 2rpx solid var(--border-light);
  transition: all 0.3s ease;
}

.feature-card:active {
  transform: scale(0.98);
  box-shadow: var(--shadow-hover);
}

/* ---------- Info Card with Icon ---------- */
.info-card {
  display: flex;
  align-items: flex-start;
  gap: 24rpx;
  background: var(--bg-card);
  border-radius: var(--radius-lg);
  padding: 32rpx;
  box-shadow: var(--shadow-card);
  border: 2rpx solid var(--border-light);
}

.info-card-icon {
  width: 80rpx;
  height: 80rpx;
  border-radius: var(--radius-md);
  display: flex;
  align-items: center;
  justify-content: center;
  flex-shrink: 0;
}

.info-card-icon-gold {
  background: var(--gold-light);
  color: var(--gold);
}

.info-card-icon-pink {
  background: var(--warning-light);
  color: var(--warning);
}

.info-card-icon-green {
  background: var(--success-light);
  color: var(--success);
}

.info-card-icon-blue {
  background: var(--info-light);
  color: var(--info);
}

/* ═══════════════════════════════════════════════
   PROGRESS & LOADING ENHANCEMENTS
   进度条与加载效果增强
   ═══════════════════════════════════════════════ */

/* ---------- Progress Bar ---------- */
.progress-bar {
  height: 8rpx;
  background: var(--gold-light);
  border-radius: 4rpx;
  overflow: hidden;
}

.progress-bar-fill {
  height: 100%;
  background: var(--gradient-gold);
  border-radius: 4rpx;
  transition: width 0.3s ease;
}

/* ---------- Detail Tabs ---------- */
.detail-tabs {
  display: flex;
  gap: 8rpx;
  margin-bottom: 32rpx;
  background: var(--bg-card);
  padding: 8rpx;
  border-radius: 24rpx;
  box-shadow: var(--shadow-sm);
}

.detail-tab {
  flex: 1;
  padding: 20rpx 16rpx;
  text-align: center;
  font-size: 26rpx;
  font-weight: 500;
  color: var(--text-secondary);
  border-radius: 16rpx;
  cursor: pointer;
  transition: all 0.2s ease;
}

.detail-tab.active {
  background: var(--gradient-gold);
  color: var(--text-inverse);
  font-weight: 600;
  box-shadow: var(--shadow-btn);
}

.detail-tab:active {
  transform: scale(0.96);
}

/* ---------- Detail List Items ---------- */
.prop-item,
.cost-item {
  display: flex;
  align-items: center;
  justify-content: space-between;
  padding: 20rpx 0;
  border-bottom: 2rpx solid rgba(0, 0, 0, 0.03);
}

.prop-item:last-child,
.cost-item:last-child {
  border-bottom: none;
}

.risk-item {
  display: flex;
  align-items: flex-start;
  gap: 12rpx;
  padding: 16rpx 20rpx;
  background: var(--warning-light);
  border-radius: 16rpx;
  margin-bottom: 12rpx;
}

.risk-item:last-child {
  margin-bottom: 0;
}

/* ---------- Timeline Dot ---------- */
.tl-dot {
  width: 16rpx;
  height: 16rpx;
  border-radius: 50%;
  background: linear-gradient(135deg, var(--gold-400), var(--gold-500));
  box-shadow: 0 2rpx 6rpx rgba(193, 154, 80, 0.3);
  flex-shrink: 0;
  margin-top: 10rpx;
  position: relative;
  z-index: 1;
}

/* ---------- Detail Actions ---------- */
.detail-actions {
  display: flex;
  gap: 20rpx;
  margin-top: 32rpx;
}

.btn-secondary {
  display: flex;
  align-items: center;
  justify-content: center;
  background: var(--bg-card);
  border: 3rpx solid var(--gold-200);
  border-radius: 9999rpx;
  padding: 0 40rpx;
  height: 96rpx;
  font-size: 26rpx;
  color: var(--gold-700);
  font-weight: 600;
  cursor: pointer;
  transition: all var(--transition);
}

.btn-secondary:active {
  background: var(--gold-50);
  transform: scale(0.98);
}

/* ---------- Animated Progress Bar ---------- */
.progress-bar-animated {
  height: 8rpx;
  background: var(--gold-light);
  border-radius: 4rpx;
  overflow: hidden;
}

.progress-fill-animated {
  height: 100%;
  background: var(--gradient-gold);
  border-radius: 4rpx;
  animation: progressFill 1s ease-out;
}

/* ---------- Shimmer Loading Effect ---------- */
.shimmer {
  position: relative;
  overflow: hidden;
}

.shimmer::after {
  content: '';
  position: absolute;
  top: 0;
  left: 0;
  right: 0;
  bottom: 0;
  background: linear-gradient(90deg, transparent, rgba(255, 255, 255, 0.3), transparent);
  animation: shimmerSlide 2s ease-in-out infinite;
}

/* ---------- Pulse Dot ---------- */
.pulse-dot {
  width: 16rpx;
  height: 16rpx;
  border-radius: 50%;
  background: var(--gold);
  animation: pulse 2s ease-in-out infinite;
}

.pulse-dot-gold {
  box-shadow: 0 0 16rpx var(--gold);
}

/* ═══════════════════════════════════════════════
   GRADIENT BACKGROUNDS
   渐变背景系统 — 轻复古·奶油风
   ═══════════════════════════════════════════════ */

.bg-gradient-gold {
  background: var(--gradient-gold);
}

.bg-gradient-gold-soft {
  background: linear-gradient(135deg, var(--gold-light), var(--gold-200));
}

.bg-gradient-warm {
  background: var(--gradient-warm);
}

.bg-gradient-hero {
  background: linear-gradient(175deg, #FFF9F2 0%, #FFFFFF 100%);
}

/* ═══════════════════════════════════════════════
   DECORATIVE ELEMENTS
   装饰性元素
   ═══════════════════════════════════════════════ */

/* ---------- Gold Divider with Gradient ---------- */
.divider-gold {
  height: 2rpx;
  background: var(--gradient-gold);
}

.divider-gold-short {
  width: 120rpx;
  height: 4rpx;
  background: var(--gradient-gold);
  border-radius: 2rpx;
}

/* ---------- Section Title Decoration ---------- */
.section-title-deco {
  position: relative;
  display: inline-flex;
  align-items: center;
  gap: 32rpx;
}

.section-title-deco::before,
.section-title-deco::after {
  content: '';
  width: 64rpx;
  height: 4rpx;
  border-radius: 2rpx;
}

.section-title-deco::before {
  background: linear-gradient(90deg, transparent, var(--gold));
}

.section-title-deco::after {
  background: linear-gradient(90deg, var(--gold), transparent);
}

/* ---------- Icon Circle ---------- */
.icon-circle {
  width: 96rpx;
  height: 96rpx;
  border-radius: 50%;
  display: flex;
  align-items: center;
  justify-content: center;
  flex-shrink: 0;
}

.icon-circle-gold {
  background: var(--gradient-gold);
  color: white;
  box-shadow: var(--shadow-gold);
}

.icon-circle-pink {
  background: linear-gradient(135deg, var(--warning-light), var(--warning));
  color: white;
  box-shadow: 0 8rpx 24rpx rgba(230, 162, 60, 0.2);
}

.icon-circle-green {
  background: linear-gradient(135deg, var(--success-light), var(--success));
  color: white;
  box-shadow: 0 8rpx 24rpx rgba(103, 194, 58, 0.2);
}

.icon-circle-blue {
  background: linear-gradient(135deg, var(--info-light), var(--info));
  color: white;
  box-shadow: 0 8rpx 24rpx rgba(144, 147, 153, 0.2);
}

/* ---------- Badge ---------- */
.badge {
  display: inline-flex;
  align-items: center;
  justify-content: center;
  min-width: 36rpx;
  height: 36rpx;
  padding: 0 10rpx;
  border-radius: 18rpx;
  font-size: 20rpx;
  font-weight: 600;
  background: var(--error);
  color: white;
}

.badge-gold {
  background: var(--gold);
  color: white;
}

.badge-outline {
  background: transparent;
  border: 2rpx solid var(--gold);
  color: var(--gold);
}

/* ═══════════════════════════════════════════════
   TRANSITION UTILITIES
   过渡效果工具类
   ═══════════════════════════════════════════════ */

.transition-all {
  transition: all 0.3s ease;
}

.transition-transform {
  transition: transform 0.3s ease;
}

.transition-opacity {
  transition: opacity 0.3s ease;
}

.transition-shadow {
  transition: box-shadow 0.3s ease;
}

/* ═══════════════════════════════════════════════
   RESPONSIVE TEXT
   响应式文字大小
   ═══════════════════════════════════════════════ */

.text-responsive-sm {
  font-size: calc(24rpx + 0.5vw);
}

.text-responsive-base {
  font-size: calc(28rpx + 0.5vw);
}

.text-responsive-lg {
  font-size: calc(32rpx + 0.5vw);
}

/* ═══════════════════════════════════════════════
   SAFE AREA UTILITIES
   安全区域工具类
   ═══════════════════════════════════════════════ */

.pb-safe {
  padding-bottom: env(safe-area-inset-bottom, 0);
}

.mb-safe {
  margin-bottom: env(safe-area-inset-bottom, 0);
}

.bottom-safe {
  bottom: env(safe-area-inset-bottom, 0);
}

/* ═══════════════════════════════════════════════
   FOOTER
   页脚样式
   ═══════════════════════════════════════════════ */

.mine-footer {
  display: flex;
  flex-direction: column;
  align-items: center;
  padding: 64rpx 0 32rpx;
  font-size: 22rpx;
  color: var(--gold-500);
}

/* ═══════════════════════════════════════════════
   QUICK ACTIONS (共用组件)
   快捷操作按钮组 — dashboard/props/hotels 等多页面使用
   ═══════════════════════════════════════════════ */

.quick-actions {
  display: flex;
  gap: 24rpx;
  margin-bottom: 24rpx;
}

.action-btn {
  flex: 1;
  background: linear-gradient(135deg, var(--bg-card), var(--gold-50));
  border-radius: 24rpx;
  padding: 28rpx 8rpx;
  text-align: center;
  border: 2rpx solid var(--gold-100);
  box-shadow: var(--shadow-md);
  cursor: pointer;
  transition: all 0.2s ease;
}

.action-btn:active {
  transform: translateY(-4rpx) scale(0.98);
  box-shadow: var(--shadow-lg);
}

.action-icon {
  display: block;
  font-size: 40rpx;
  color: var(--gold-500);
  margin-bottom: 8rpx;
}

.action-label {
  display: block;
  font-size: 22rpx;
  color: var(--gold-700);
  font-weight: 500;
}

/* ═══════════════════════════════════════════════
   TODO ITEM (共用组件)
   待办事项列表 — dashboard/hotels/props 等多页面使用
   ═══════════════════════════════════════════════ */

.todo-item {
  display: flex;
  align-items: center;
  gap: 20rpx;
  padding: 20rpx 0;
  border-bottom: 2rpx solid rgba(0, 0, 0, 0.04);
  cursor: pointer;
  transition: all 0.2s ease;
}

.todo-item:last-child {
  border-bottom: none;
}

.todo-item:active {
  background: var(--gold-50);
}

.todo-check {
  width: 40rpx;
  height: 40rpx;
  border-radius: 50%;
  border: 4rpx solid var(--gold-200);
  display: flex;
  align-items: center;
  justify-content: center;
  flex-shrink: 0;
  font-size: 22rpx;
  color: var(--text-inverse);
  transition: all 0.2s ease;
}

.todo-check.checked {
  background: linear-gradient(135deg, var(--gold-400), var(--gold-500));
  border-color: var(--gold-400);
  box-shadow: var(--shadow-sm);
}

.todo-content {
  flex: 1;
}

.todo-text {
  display: block;
  font-size: 28rpx;
  color: var(--gold-800);
}

.todo-done .todo-text {
  text-decoration: line-through;
  color: var(--gold-500);
}

.todo-time {
  display: block;
  font-size: 22rpx;
  color: var(--gold-500);
  margin-top: 4rpx;
}

/* ═══════════════════════════════════════════════
   SEARCH BAR (共用组件)
   搜索栏 — dashboard 等页面使用
   ═══════════════════════════════════════════════ */

.search-bar {
  display: flex;
  align-items: center;
  background: linear-gradient(135deg, var(--gold-50), var(--bg-card));
  border-radius: 9999rpx;
  padding: 20rpx 32rpx;
  margin-bottom: 24rpx;
  border: 3rpx solid var(--gold-200);
  box-shadow: var(--shadow-sm);
  cursor: pointer;
  transition: all 0.2s ease;
}

.search-bar:active {
  border-color: var(--gold-400);
  background: var(--bg-card);
}

.search-icon {
  margin-right: 16rpx;
  font-size: 30rpx;
  color: var(--gold-400);
}

.search-placeholder {
  font-size: 28rpx;
  color: var(--gold-500);
}

/* ═══════════════════════════════════════════════
   EMPTY STATE (共用组件)
   空状态提示 — 多页面使用
   ═══════════════════════════════════════════════ */

.empty-state {
  display: flex;
  flex-direction: column;
  align-items: center;
  justify-content: center;
  padding: 96rpx 0;
  text-align: center;
  color: var(--gold-500);
  font-size: 26rpx;
}

.empty-wrap {
  display: flex;
  flex-direction: column;
  align-items: center;
  padding: 40rpx;
}

.empty-illustration-gift {
  width: 160rpx;
  height: 160rpx;
  margin-bottom: 32rpx;
  position: relative;
}

.gift-box {
  width: 120rpx;
  height: 80rpx;
  background: linear-gradient(135deg, var(--gold-200), var(--gold-300));
  border-radius: 16rpx;
  position: absolute;
  bottom: 0;
  left: 20rpx;
}

.gift-lid {
  width: 130rpx;
  height: 24rpx;
  background: linear-gradient(135deg, var(--gold-300), var(--gold-400));
  border-radius: 12rpx;
  position: absolute;
  bottom: 80rpx;
  left: 15rpx;
}

.gift-ribbon {
  width: 16rpx;
  height: 80rpx;
  background: var(--gold-400);
  position: absolute;
  bottom: 0;
  left: 72rpx;
}

.gift-bow {
  width: 40rpx;
  height: 24rpx;
  background: var(--gold-400);
  border-radius: 50%;
  position: absolute;
  bottom: 104rpx;
  left: 60rpx;
}

.empty-title {
  font-size: 32rpx;
  font-weight: 600;
  color: var(--gold-700);
  display: block;
  margin-bottom: 12rpx;
}

.empty-desc {
  font-size: 26rpx;
  color: var(--gold-500);
  display: block;
  margin-bottom: 32rpx;
}

.empty-cta {
  background: linear-gradient(135deg, var(--gold-400), var(--gold-500));
  color: var(--text-inverse);
  font-size: 28rpx;
  font-weight: 600;
  padding: 20rpx 48rpx;
  border-radius: 9999rpx;
  border: none;
  box-shadow: var(--shadow-gold);
  cursor: pointer;
  transition: all 0.2s ease;
}

.empty-cta:active {
  transform: scale(0.97);
}

.empty-text {
  font-size: 26rpx;
  color: var(--gold-500);
}

/* ═══════════════════════════════════════════════
   STAT ROW (共用组件)
   统计卡片行 — dashboard/profile/contracts/clients/orders 等多页面使用
   ═══════════════════════════════════════════════ */

.stat-row {
  display: flex;
  gap: 24rpx;
  margin-bottom: 24rpx;
  align-items: center;
}

.stat-item {
  flex: 1;
  background: linear-gradient(135deg, var(--bg-card), var(--gold-50));
  border: 2rpx solid var(--gold-100);
  box-shadow: var(--shadow-md);
  border-radius: 24rpx;
  padding: 24rpx 16rpx;
  text-align: center;
  transition: all 0.2s ease;
}

.stat-item:active {
  transform: translateY(-2rpx);
  box-shadow: var(--shadow-lg);
}

.stat-card {
  flex: 1;
  background: linear-gradient(135deg, var(--bg-card), var(--gold-50));
  border: 2rpx solid var(--gold-100);
  box-shadow: var(--shadow-md);
  border-radius: 24rpx;
  padding: 24rpx 16rpx;
  text-align: center;
  transition: all 0.2s ease;
}

.stat-card:active {
  transform: translateY(-2rpx);
  box-shadow: var(--shadow-lg);
}

.stat-num {
  display: block;
  font-size: 40rpx;
  font-weight: 700;
  color: var(--gold-600);
  letter-spacing: -1rpx;
  font-family: var(--font-en-display);
}

.stat-label {
  display: block;
  font-size: 22rpx;
  color: var(--gold-500);
  margin-top: 8rpx;
}

.stat-icon {
  display: block;
  font-size: 36rpx;
  color: var(--gold-400);
  margin-bottom: 12rpx;
}

/* ═══════════════════════════════════════════════
   SECTION TITLE (共用组件)
   区块标题 — 多页面使用
   ═══════════════════════════════════════════════ */

.section-title {
  display: flex;
  align-items: center;
  gap: 12rpx;
  font-size: 28rpx;
  font-weight: 600;
  color: var(--gold-800);
  margin-bottom: 24rpx;
}

.gold-bar {
  width: 6rpx;
  height: 28rpx;
  background: linear-gradient(180deg, var(--gold-400), var(--gold-500));
  border-radius: 3rpx;
}

.gold-dot {
  width: 12rpx;
  height: 12rpx;
  background: linear-gradient(135deg, var(--gold-400), var(--gold-500));
  border-radius: 50%;
  box-shadow: var(--shadow-sm);
}

.section-title .more {
  margin-left: auto;
  font-size: 24rpx;
  color: var(--gold-500);
  font-weight: 500;
}

/* ═══════════════════════════════════════════════
   INSIGHT CARD (共用组件)
   洞察卡片 — dashboard 页面使用
   ═══════════════════════════════════════════════ */

.insight-row {
  display: flex;
  gap: 24rpx;
  margin-bottom: 24rpx;
}

.insight-card {
  flex: 1;
  display: flex;
  align-items: center;
  gap: 20rpx;
  padding: 28rpx;
}

.insight-icon-wrap {
  width: 72rpx;
  height: 72rpx;
  border-radius: 50%;
  display: flex;
  align-items: center;
  justify-content: center;
  flex-shrink: 0;
}

.insight-info {
  flex: 1;
  min-width: 0;
}

.insight-value {
  display: block;
  font-size: 36rpx;
  font-weight: 700;
  color: var(--gold-700);
  font-family: var(--font-en-display);
  line-height: 1.2;
}

.insight-label {
  display: block;
  font-size: 22rpx;
  color: var(--gold-500);
  margin-top: 4rpx;
}

/* ═══════════════════════════════════════════════
   ALERT CARD (共用组件)
   预警卡片 — dashboard 页面使用
   ═══════════════════════════════════════════════ */

.alert-card {
  display: flex;
  align-items: center;
  gap: 24rpx;
  padding: 28rpx 32rpx;
  margin-bottom: 24rpx;
  cursor: pointer;
  position: relative;
  overflow: hidden;
  background: linear-gradient(135deg, var(--bg-card), var(--gold-50));
  border: 2rpx solid var(--gold-100);
  box-shadow: var(--shadow-md);
  transition: all 0.2s ease;
  border-radius: 24rpx;
}

.alert-card::before {
  display: none;
}

.alert-card:active {
  transform: translateY(-4rpx);
  box-shadow: var(--shadow-lg);
}

.alert-bar {
  width: 6rpx;
  height: 72rpx;
  background: linear-gradient(180deg, var(--warning), var(--warning-light));
  border-radius: 4rpx;
  flex-shrink: 0;
}

.alert-body {
  flex: 1;
  display: flex;
  align-items: center;
  justify-content: space-between;
}

.alert-left {
  display: flex;
  align-items: center;
  gap: 16rpx;
}

.alert-icon {
  width: 44rpx;
  height: 44rpx;
  border-radius: 50%;
  background: var(--warning-light);
  color: var(--warning);
  display: flex;
  align-items: center;
  justify-content: center;
  font-size: 26rpx;
  font-weight: 700;
  box-shadow: var(--shadow-sm);
}

.alert-title {
  font-size: 28rpx;
  font-weight: 600;
  color: var(--text-primary);
}

.alert-right {
  text-align: right;
}

.alert-count {
  display: block;
  font-size: 26rpx;
  color: var(--gold-700);
  font-weight: 700;
}

.alert-overdue {
  display: block;
  font-size: 22rpx;
  color: var(--warning);
  margin-top: 4rpx;
}

.alert-arrow {
  font-size: 32rpx;
  color: var(--text-secondary);
  flex-shrink: 0;
}

/* ═══════════════════════════════════════════════
   ORDER CARD (共用组件)
   订单卡片 — dashboard/orders/schedule 等多页面使用
   ═══════════════════════════════════════════════ */

.order-card {
  cursor: pointer;
  transition: all 0.2s ease;
}

.order-card:active {
  opacity: 0.8;
  transform: translateY(-2rpx);
}

.order-header {
  display: flex;
  align-items: center;
  gap: 20rpx;
}

.order-avatar {
  width: 72rpx;
  height: 72rpx;
  border-radius: 50%;
  display: inline-flex;
  align-items: center;
  justify-content: center;
  font-size: 28rpx;
  font-weight: 600;
  color: var(--text-inverse);
  flex-shrink: 0;
  background: linear-gradient(135deg, var(--gold-400), var(--gold-500));
  box-shadow: var(--shadow-gold);
}

.order-info {
  flex: 1;
  min-width: 0;
}

.order-name {
  display: block;
  font-size: 28rpx;
  font-weight: 600;
  color: var(--gold-800);
}

.order-date {
  display: block;
  font-size: 24rpx;
  color: var(--gold-500);
  margin-top: 4rpx;
}

.order-tag {
  flex-shrink: 0;
}

.order-tags {
  display: flex;
  gap: 12rpx;
  margin-top: 16rpx;
  flex-wrap: wrap;
}

.order-tag-item {
  display: inline-block;
  padding: 4rpx 16rpx;
  background: var(--gold-100);
  border-radius: 24rpx;
  font-size: 20rpx;
  color: var(--gold-600);
}

.order-footer {
  display: flex;
  justify-content: space-between;
  align-items: center;
  margin-top: 16rpx;
  padding-top: 16rpx;
  border-top: 2rpx solid var(--border);
}

.order-amount {
  font-size: 28rpx;
  font-weight: 700;
  color: var(--gold-600);
  font-family: var(--font-en-display);
}

/* ═══════════════════════════════════════════════
   PROFILE GRID (共用组件)
   功能入口网格 — profile 页面使用
   ═══════════════════════════════════════════════ */

.profile-grid {
  display: flex;
  flex-wrap: wrap;
  gap: 24rpx;
  padding: 32rpx;
}

.profile-grid-item {
  flex: 1;
  min-width: calc(33.333% - 16rpx);
  display: flex;
  flex-direction: column;
  align-items: center;
  justify-content: center;
  padding: 24rpx 16rpx;
  background: var(--bg-card);
  border-radius: 24rpx;
  border: 2rpx solid var(--gold-100);
  transition: all 0.2s ease;
  cursor: pointer;
}

.profile-grid-item:active {
  transform: scale(0.96);
  background: var(--gold-50);
}

.profile-grid-icon {
  width: 56rpx;
  height: 56rpx;
  margin-bottom: 12rpx;
  color: var(--gold);
}

.profile-grid-label {
  font-size: 24rpx;
  color: var(--text-primary);
  font-weight: 500;
  text-align: center;
}

.profile-name {
  font-size: 36rpx;
  font-weight: 700;
  color: var(--text-inverse);
  display: block;
  margin-bottom: 8rpx;
}

.profile-role {
  font-size: 26rpx;
  color: rgba(255, 255, 255, 0.8);
  display: block;
}

.profile-phone {
  font-size: 24rpx;
  color: rgba(255, 255, 255, 0.7);
  display: block;
  margin-top: 8rpx;
}

/* ═══════════════════════════════════════════════
   LOADING STATE (共用组件)
   加载状态 — 多页面使用
   ═══════════════════════════════════════════════ */

.loading-state {
  display: flex;
  flex-direction: column;
  align-items: center;
  justify-content: center;
  padding: 96rpx 0;
}

/* ═══════════════════════════════════════════════
   PAGE WRAPPER (共用组件)
   页面容器 — hotels/props 等页面使用
   ═══════════════════════════════════════════════ */

.page-wrap {
  padding: 24rpx 32rpx calc(120rpx + env(safe-area-inset-bottom, 0px));
  background: var(--bg-primary);
  min-height: 100vh;
}

/* ═══════════════════════════════════════════════
   CLIENT RICH CARD (共用组件)
   客户详情卡片 — hotels 页面使用
   ═══════════════════════════════════════════════ */

.client-rich-card {
  background: linear-gradient(135deg, var(--bg-card), var(--gold-50));
  border: 2rpx solid var(--gold-100);
  box-shadow: var(--shadow-md);
  border-radius: 32rpx;
  margin-bottom: 24rpx;
  overflow: hidden;
  transition: all 0.2s ease;
}

.client-rich-card:active {
  transform: translateY(-4rpx);
  box-shadow: var(--shadow-lg);
}

.accent-bar {
  width: 8rpx;
  height: 100%;
  position: absolute;
  left: 0;
  top: 0;
}

.accent-bar.active {
  background: linear-gradient(180deg, var(--gold-400), var(--gold-500));
}

.accent-bar.inactive {
  background: var(--gold-200);
}

.card-body {
  display: flex;
  align-items: center;
  gap: 20rpx;
  padding: 28rpx 32rpx;
}

.card-avatar {
  width: 72rpx;
  height: 72rpx;
  border-radius: 50%;
  display: flex;
  align-items: center;
  justify-content: center;
  font-size: 28rpx;
  font-weight: 600;
  color: var(--text-inverse);
  flex-shrink: 0;
  background: linear-gradient(135deg, var(--gold-400), var(--gold-500));
  box-shadow: var(--shadow-gold);
}

.card-info {
  flex: 1;
  min-width: 0;
}

.ci-name {
  display: block;
  font-size: 28rpx;
  font-weight: 600;
  color: var(--gold-800);
}

.ci-date {
  display: block;
  font-size: 24rpx;
  color: var(--gold-500);
  margin-top: 4rpx;
}

.ci-tags {
  display: flex;
  gap: 12rpx;
  margin-top: 12rpx;
  flex-wrap: wrap;
}

.ci-tag {
  display: inline-block;
  padding: 4rpx 16rpx;
  background: var(--gold-100);
  border-radius: 24rpx;
  font-size: 20rpx;
  color: var(--gold-600);
}

.card-right {
  display: flex;
  flex-direction: column;
  align-items: flex-end;
  gap: 8rpx;
}

.ci-status {
  font-size: 22rpx;
  padding: 6rpx 20rpx;
  border-radius: 999rpx;
  font-weight: 500;
}

.ci-status.active {
  background: var(--success-light);
  color: var(--success);
}

.ci-status.inactive {
  background: var(--gold-100);
  color: var(--gold-600);
}

/* ═══════════════════════════════════════════════
   PROP STATS (共用组件)
   道具统计 — hotels 页面使用
   ═══════════════════════════════════════════════ */

.prop-stats {
  display: flex;
  gap: 16rpx;
  margin-bottom: 24rpx;
}

.ps {
  flex: 1;
  background: linear-gradient(135deg, var(--bg-card), var(--gold-50));
  border: 2rpx solid var(--gold-100);
  box-shadow: var(--shadow-sm);
  border-radius: 20rpx;
  padding: 20rpx 12rpx;
  text-align: center;
}

.ps-num {
  display: block;
  font-size: 36rpx;
  font-weight: 700;
  color: var(--gold-600);
  font-family: var(--font-en-display);
}

.ps-lbl {
  display: block;
  font-size: 20rpx;
  color: var(--gold-500);
  margin-top: 4rpx;
}

/* ═══════════════════════════════════════════════
   PROP CATEGORY GRID (共用组件)
   道具分类网格 — props 页面使用
   ═══════════════════════════════════════════════ */

.prop-cat-grid {
  display: flex;
  flex-wrap: wrap;
  gap: 16rpx;
  margin-bottom: 24rpx;
}

.prop-cat {
  flex: 0 0 calc(25% - 12rpx);
  background: linear-gradient(135deg, var(--bg-card), var(--gold-50));
  border: 2rpx solid var(--gold-100);
  border-radius: 20rpx;
  padding: 20rpx 12rpx;
  text-align: center;
  cursor: pointer;
  transition: all 0.2s ease;
}

.prop-cat:active {
  transform: scale(0.95);
}

.prop-cat-active {
  border-color: var(--gold);
  background: linear-gradient(135deg, var(--gold-100), var(--gold-200));
  box-shadow: var(--shadow-gold);
}

.pc-icon {
  width: 40rpx;
  height: 40rpx;
  margin: 0 auto 8rpx;
  display: flex;
  align-items: center;
  justify-content: center;
}

.pc-name {
  display: block;
  font-size: 24rpx;
  font-weight: 600;
  color: var(--gold-700);
  margin-bottom: 4rpx;
  overflow: hidden;
  text-overflow: ellipsis;
  white-space: nowrap;
}

.pc-count {
  display: block;
  font-size: 18rpx;
  color: var(--gold-500);
  overflow: hidden;
  text-overflow: ellipsis;
  white-space: nowrap;
}

/* ═══════════════════════════════════════════════
   EMPTY STATE (简化版)
   空状态提示 — 多页面使用
   ═══════════════════════════════════════════════ */

.empty {
  display: flex;
  flex-direction: column;
  align-items: center;
  justify-content: center;
  padding: 80rpx 40rpx;
  text-align: center;
  color: var(--text-muted);
  font-size: 26rpx;
}

/* ═══════════════════════════════════════════════
   MORE LINK (共用组件)
   更多链接 — section-title 右侧使用
   ═══════════════════════════════════════════════ */

.more {
  font-size: 24rpx;
  color: var(--gold);
  font-weight: 500;
  cursor: pointer;
  margin-left: auto;
}

.more:active {
  opacity: 0.7;
}

/* ═══════════════════════════════════════════════
   PROP ITEM (共用组件)
   道具列表项 — props 页面使用
   ═══════════════════════════════════════════════ */

.prop-item {
  display: flex;
  align-items: center;
  justify-content: space-between;
  background: linear-gradient(135deg, var(--bg-card), var(--gold-50));
  border: 2rpx solid var(--gold-100);
  border-radius: 20rpx;
  padding: 20rpx 24rpx;
  margin-bottom: 12rpx;
  box-shadow: var(--shadow-sm);
  transition: all 0.2s ease;
}

.prop-item:active {
  transform: translateY(-2rpx);
  box-shadow: var(--shadow-md);
}

.pi-info {
  flex: 1;
  min-width: 0;
}

.pi-name {
  display: block;
  font-size: 26rpx;
  font-weight: 600;
  color: var(--gold-800);
  margin-bottom: 4rpx;
  overflow: hidden;
  text-overflow: ellipsis;
  white-space: nowrap;
}

.pi-meta {
  display: block;
  font-size: 22rpx;
  color: var(--gold-500);
  overflow: hidden;
  text-overflow: ellipsis;
  white-space: nowrap;
}

.pi-actions {
  display: flex;
  gap: 12rpx;
  flex-shrink: 0;
  margin-left: 12rpx;
}

.pi-actions button {
  background: linear-gradient(135deg, var(--gold-100), var(--gold-200));
  border: 2rpx solid var(--gold-200);
  color: var(--gold-700);
  padding: 10rpx 20rpx;
  border-radius: 20rpx;
  font-size: 22rpx;
  font-weight: 500;
  transition: all 0.2s ease;
}

.pi-actions button:active {
  transform: scale(0.95);
  box-shadow: var(--shadow-sm);
}

.pi-actions button.primary {
  background: linear-gradient(135deg, var(--gold-400), var(--gold-500));
  border-color: var(--gold-400);
  color: var(--text-inverse);
  box-shadow: var(--shadow-gold);
}

