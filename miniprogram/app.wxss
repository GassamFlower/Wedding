/* =============================================
   app.wxss — 轻复古·奶油风 Design System
   暖白基底 + 香槟金点缀
   ============================================= */

/* ---------- 轻复古·奶油风 Design Tokens ---------- */
/* Based on ui-specification.md v1.1 — 2026-06-24 */
page {
  /* ═══ 核心色板 — 暖白基底 + 香槟金点缀 ═══ */
  --bg-primary:    #FFF9F2;   /* 主背景 - 暖白基底 */
  --bg-card:       #FFFFFF;   /* 卡片背景 - 纯白 */
  --gold:          #D4AF37;   /* 品牌金（主色）- 香槟金 */
  --gold-light:    #F5E6C8;   /* 辅助金（浅）- 标签底色、边框 */
  --text-primary:  #2C2C2C;   /* 主文字 - 深灰 */
  --text-secondary:#8C8C8C;   /* 次要文字 - 中灰 */
  --glass-bg:      rgba(255, 255, 255, 0.72);  /* 毛玻璃底色 */
  
  /* ═══ 渐变 ═══ */
  --gradient-gold: linear-gradient(135deg, #D4AF37 0%, #E8C86A 100%);
  --gradient-warm: linear-gradient(180deg, #FFF9F2 0%, #FFFFFF 100%);
  
  /* ═══ 状态色 ═══ */
  --success:       #67C23A;
  --success-light: #E8F5E9;
  --warning:       #E6A23C;
  --warning-light: #FFF3E0;
  --error:         #F56C6C;
  --error-light:   #FFEBEE;
  --info:          #909399;
  --info-light:    #F5F5F5;
  
  /* ═══ 阴影系统 — 对齐 HTML 设计归档 ═══ */
  --shadow-card: 0 4rpx 24rpx rgba(0, 0, 0, 0.06);
  --shadow-btn: 0 4rpx 8rpx rgba(212, 175, 55, 0.2);
  --shadow-hover: 0 8rpx 32rpx rgba(0, 0, 0, 0.10);
  
  /* ═══ 圆角系统 ═══ */
  --radius-sm: 12rpx;
  --radius-md: 20rpx;
  --radius-lg: 32rpx;
  --radius-full: 9999rpx;
  
  /* ═══ 间距系统 ═══ */
  --spacing-sm: 16rpx;
  --spacing-md: 24rpx;
  --spacing-lg: 32rpx;
  
  /* ═══ 边框 ═══ */
  --border-light: #F5E6C8;
  --divider: #F5E6C8;
  
  /* ═══ 字体 ═══ */
  --font-family: 'PingFang SC', 'Noto Sans SC', sans-serif;
  --font-display: 'Playfair Display', Georgia, serif;
  
  /* ═══ 向后兼容别名 — 对齐 HTML 设计归档色阶 ═══ */
  --primary:       var(--gold);
  --primary-light: var(--gold-light);
  --primary-dark:  #C09A2E;
  --gold-50:       #FDF8EF;
  --gold-100:      #FBF0D9;
  --gold-200:      #F5E6C8;
  --gold-300:      #E8D5A3;
  --gold-400:      #D4AF37;
  --gold-500:      #C09A2E;
  --gold-600:      #A07D22;
  --gold-700:      #7D6019;
  --gold-800:      #5C4512;
  --gold-900:      #3D2C0A;
  --gold-bg:       rgba(212, 175, 55, 0.12);
  --gold-bg-12:    rgba(212, 175, 55, 0.12);
  --text:          var(--text-primary);
  --text-muted:    var(--text-secondary);
  --bg:            var(--bg-primary);
  --bg-warm:       var(--gold-light);
  --cream:         var(--bg-primary);
  --cream-dark:    var(--gold-light);
  --border:        var(--border-light);
  --warm-brown:    var(--gold-700);
  --light-beige:   var(--gold-200);
  --red-warn:      var(--error);
  --red-bg:        rgba(245, 108, 108, 0.08);

  /* ═══ 灰色系别名（向后兼容） ═══ */
  --gray:          #8C8C8C;
  --gray-light:    #BFBFBF;
  --grey-blue:     var(--gold-500);
  --text-main:     var(--text-primary);
  --text-second:   var(--text-secondary);
  --text-inverse:  #FFFFFF;
  --white:         #FFFFFF;
  --dark:          var(--text-primary);
  --bg-main:       var(--bg-primary);
  --bg-input:      #F5F0E8;
  --bg-secondary:  var(--bg-primary);
  --border-line:   var(--border-light);
  --border-default:var(--border-light);
  --border-light:  #F5E6C8;
  --ease:          .25s cubic-bezier(.34,1.56,.64,1);
  --ease-spring:   cubic-bezier(.34,1.56,.64,1);
  --shadow-watercolor: var(--shadow-sm);

  /* ═══ 扩展圆角 ═══ */
  --radius: 16rpx;
  --radius-xl: 48rpx;

  /* ═══ 扩展间距 ═══ */
  --spacing-xs: 8rpx;
  --spacing-xl: 64rpx;
  --spacing-2xl: 96rpx;
  --spacing-3xl: 128rpx;

  /* ═══ 扩展阴影 ═══ */
  --shadow-sm: 0 2rpx 4rpx rgba(0, 0, 0, 0.04);
  --shadow-md: 0 8rpx 16rpx rgba(0, 0, 0, 0.06);
  --shadow-lg: 0 16rpx 32rpx rgba(0, 0, 0, 0.08);
  --shadow-xl: 0 32rpx 64rpx rgba(0, 0, 0, 0.12);
  --shadow-gold: 0 8rpx 24rpx rgba(212, 175, 55, 0.2);
  --shadow-gold-lg: 0 16rpx 48rpx rgba(212, 175, 55, 0.3);

  /* ═══ 字体 ═══ */
  --font-serif: "Songti SC", "STSong", "Noto Serif CJK SC", "SimSun", serif;
  --font-en-body: 'Lato', 'Helvetica Neue', sans-serif;
  --font-en-display: 'Playfair Display', Georgia, serif;
  --transition: .25s cubic-bezier(.34,1.56,.64,1);
  --transition-slow: .4s cubic-bezier(.34,1.56,.64,1);
}

page { background:var(--bg); color:var(--text); font-size:28rpx; line-height:1.6; -webkit-font-smoothing:antialiased; }

/* ---------- Cream Wash Decorators ---------- */
.watercolor-blob {
  position:absolute;
  border-radius:50%;
  pointer-events:none;
  z-index:0;
  filter:blur(80rpx);
  opacity:0.06;
}
.watercolor-blob-1 {
  width:600rpx; height:600rpx;
  background:radial-gradient(ellipse, var(--gold-light), transparent);
  top:-160rpx; right:-120rpx;
}
.watercolor-blob-2 {
  width:400rpx; height:400rpx;
  background:radial-gradient(ellipse, var(--gold), transparent);
  bottom:-80rpx; left:-80rpx;
}
.watercolor-blob-3 {
  width:360rpx; height:360rpx;
  background:radial-gradient(ellipse, var(--gold-light), transparent);
  top:50%; left:-120rpx;
}

/* ---------- Layered Card System (Card-based design with layered elements) ---------- */
.card {
  background:var(--bg-card);
  border-radius:32rpx;
  padding:24rpx;
  box-shadow:var(--shadow-card);
  position:relative;
  overflow:hidden;
  transition:opacity var(--transition);
  border:2rpx solid var(--border-light);
}
.card:active { transform:scale(0.98); opacity:0.85; }
.card::before {
  content:'';
  position:absolute;
  top:0; left:0; right:0;
  height:2rpx;
  background:linear-gradient(90deg, transparent, rgba(212,175,55,0.08), transparent);
}
/* 紧凑变体：极致信息密度（列表/时间轴用） */
.card-compact { padding:20rpx; }
/* 预警变体：暖调粉底 + 左侧红线 */
.card-warm {
  background:var(--warning-light);
  border-left:6rpx solid var(--warning);
  padding:24rpx 28rpx;
}
.card-warm .card::before { display:none; }

.card-premium {
  background:var(--bg-card);
  border-radius:32rpx;
  padding:24rpx;
  box-shadow:var(--shadow-hover);
  position:relative;
  overflow:hidden;
  transition:all var(--transition);
  border:2rpx solid var(--border-light);
}
.card-premium:active { transform:scale(0.98); opacity:0.85; }
.card-premium::before {
  content:'';
  position:absolute;
  top:0; left:0; right:0;
  height:2rpx;
  background:linear-gradient(90deg, transparent, rgba(212,175,55,0.12), transparent);
}

.card-elevated {
  background:var(--bg-card);
  border-radius:32rpx;
  padding:32rpx;
  box-shadow:var(--shadow-lg);
  position:relative;
  overflow:hidden;
  border:2rpx solid var(--border-light);
}

.card-glass {
  background:var(--glass-bg);
  backdrop-filter:blur(40rpx);
  -webkit-backdrop-filter:blur(40rpx);
  border-radius:48rpx;
  padding:36rpx;
  box-shadow:var(--shadow-card);
  border:2rpx solid rgba(245,230,200,0.3);
}

.card-gradient {
  background:var(--gradient-gold);
  border-radius:48rpx;
  padding:48rpx;
  color:#fff;
  box-shadow:var(--shadow-gold);
}

/* ---------- Watercolor Wash Accent Layers ---------- */
.wash-layer {
  position:absolute;
  inset:0;
  pointer-events:none;
  z-index:0;
}
.wash-layer::before {
  content:'';
  position:absolute;
  top:-20%; right:-10%;
  width:50%; height:80%;
  background:radial-gradient(ellipse at center, rgba(193,154,80,0.04) 0%, transparent 65%);
}
.wash-layer::after {
  content:'';
  position:absolute;
  bottom:-15%; left:-10%;
  width:40%; height:60%;
  background:radial-gradient(ellipse at center, rgba(232,197,187,0.03) 0%, transparent 55%);
}

/* ---------- Typography ---------- */

/* ---------- Card Layout - Layered Information ---------- */
.card-top-image { display:flex; flex-direction:column; }
.card-top-image .card-media { width:100%; border-radius:var(--radius-lg) var(--radius-lg) var(--radius-sm) var(--radius-sm); overflow:hidden; position:relative; aspect-ratio:4/3; }
.card-top-image .card-body { padding:24rpx 0 8rpx; display:flex; flex-direction:column; gap:10rpx; }
.card-left-image { display:flex; flex-direction:row; gap:28rpx; }
.card-left-image .card-media { width:160rpx; height:160rpx; border-radius:var(--radius-md); overflow:hidden; flex-shrink:0; }
.card-left-image .card-body { flex:1; display:flex; flex-direction:column; justify-content:center; }
.card-title { font-size:30rpx; font-weight:600; color:var(--text-primary); line-height:1.4; display:block; }
.card-subtitle { font-size:24rpx; font-weight:400; color:var(--text-secondary); display:block; margin-top:4rpx; }
.card-tags { display:flex; flex-wrap:wrap; gap:12rpx; }
.card-tag { padding:4rpx 20rpx; background:var(--gold-light); border-radius:12rpx; font-size:22rpx; color:var(--gold); }
.card-meta { font-size:24rpx; color:var(--text-secondary); display:flex; align-items:center; gap:8rpx; margin-top:4rpx; }

/* ---------- Text System ---------- */
.text-display { font-size:48rpx; font-weight:700; line-height:64rpx; letter-spacing:-1rpx; }
.text-display-sm { font-size:44rpx; font-weight:700; line-height:60rpx; letter-spacing:-.6rpx; }
.text-h1 { font-size:48rpx; font-weight:700; line-height:64rpx; }
.text-h2 { font-size:36rpx; font-weight:600; line-height:52rpx; }
.text-h3 { font-size:32rpx; font-weight:500; line-height:44rpx; }
.text-body { font-size:28rpx; line-height:40rpx; }
.text-body-sm { font-size:26rpx; line-height:36rpx; }
.text-caption { font-size:24rpx; line-height:36rpx; color:var(--text-secondary); }
.text-xs { font-size:22rpx; }
.text-sm { font-size:26rpx; }
.text-base { font-size:28rpx; }
.text-lg { font-size:32rpx; }
.text-xl { font-size:36rpx; }
.text-2xl { font-size:44rpx; }
.text-3xl { font-size:52rpx; }
.font-400 { font-weight:400; }
.font-500 { font-weight:500; }
.font-600 { font-weight:600; }
.font-700 { font-weight:700; }
.font-800 { font-weight:800; }
.text-center { text-align:center; }
.text-left { text-align:left; }
.text-right { text-align:right; }
.text-primary { color:var(--text-primary); }
.text-gold { color:var(--gold); }
.text-muted { color:var(--text-secondary); }
.text-secondary { color:var(--text-secondary); }
.text-danger { color:var(--error); }
.text-success { color:var(--success); }

/* ---------- Serif Typography ---------- */
.text-serif { font-family:var(--font-serif); }
.text-display-serif { font-family:var(--font-display); font-size:56rpx; font-weight:700; line-height:1.35; letter-spacing:4rpx; }
.text-quote-serif { font-family:var(--font-serif); font-size:36rpx; font-weight:600; line-height:1.7; letter-spacing:3rpx; color:var(--text-primary); }

/* ---------- Spacing enhancements ---------- */
.space-sm { height:16rpx; }
.space-md { height:24rpx; }
.space-lg { height:32rpx; }
.space-xl { height:64rpx; }

/* ---------- Layout ---------- */
.page { padding:24rpx 32rpx calc(120rpx + env(safe-area-inset-bottom,0px)); background:var(--bg-primary); }
.page-wrap { height:100%; overflow-y:auto; -webkit-overflow-scrolling:touch; }
.flex-row { display:flex; flex-direction:row; align-items:center; }
.flex-col { display:flex; flex-direction:column; }
.flex-center { display:flex; align-items:center; justify-content:center; }
.flex-between { display:flex; flex-direction:row; align-items:center; justify-content:space-between; }
.flex-wrap { flex-wrap:wrap; }
.flex-1 { flex:1; }
.flex-shrink-0 { flex-shrink:0; }
.gap-2 { gap:4rpx; }
.gap-4 { gap:8rpx; }
.gap-6 { gap:12rpx; }
.gap-8 { gap:16rpx; }
.gap-10 { gap:20rpx; }
.gap-12 { gap:24rpx; }
.gap-14 { gap:28rpx; }
.gap-16 { gap:32rpx; }
.gap-20 { gap:40rpx; }
.gap-24 { gap:48rpx; }

/* ---------- Gold Bar Decoration ---------- */
.gold-bar { display:inline-block; width:8rpx; height:32rpx; background:var(--gradient-gold); border-radius:0; flex-shrink:0; vertical-align:middle; }
.gold-dot { display:inline-block; width:16rpx; height:16rpx; background:var(--gold); border-radius:50%; margin-right:16rpx; flex-shrink:0; vertical-align:middle; }

/* ---------- Dividers ---------- */
.divider { height:2rpx; background:var(--border); margin:24rpx 0; }
.divider-light { height:2rpx; background:rgba(193,154,80,0.04); margin:16rpx 0; }

/* ---------- Avatar ---------- */
.avatar { display:inline-flex; align-items:center; justify-content:center; border-radius:50%; flex-shrink:0; font-weight:600; color:#fff; width:80rpx; height:80rpx; font-size:32rpx; }
.avatar-1 { background:var(--gradient-gold); }
.avatar-2 { background:linear-gradient(135deg,var(--gold),var(--gold-light)); }
.avatar-3 { background:linear-gradient(135deg,var(--gold-600),var(--gold-400)); }
.avatar-4 { background:linear-gradient(135deg,var(--gold-500),var(--gold-300)); }
.avatar-sm { width:56rpx; height:56rpx; font-size:24rpx; }
.avatar-md { width:72rpx; height:72rpx; font-size:28rpx; }
.avatar-lg { width:96rpx; height:96rpx; font-size:40rpx; }

/* ---------- Tags ---------- */
.tag { display:inline-block; padding:6rpx 20rpx; border-radius:48rpx; font-size:22rpx; font-weight:500; background:var(--gold-light); color:var(--gold); line-height:1.4; }
/* pill 变体 */
.tag-pill { border-radius:9999rpx; padding:6rpx 20rpx; font-size:22rpx; }
/* 状态变体 */
.tag--done { background:var(--success-light); color:var(--success); }
.tag--pending { background:var(--warning-light); color:var(--warning); }
.tag--progress { background:var(--gold-light); color:var(--gold); }
/* 策划师端状态色 */
.tag-progress { background:var(--gold-light); color:var(--gold); }
.tag-done { background:var(--success-light); color:var(--success); }
.tag-cancel { background:var(--error-light); color:var(--error); }
.tag-pending { background:var(--info-light); color:var(--info); }
.tag-red { background:var(--error-light); color:var(--error); }
.tag-green { background:var(--success-light); color:var(--success); }
.tag-yellow { background:var(--warning-light); color:var(--warning); }
.tag-gold { background:var(--gold-light); color:var(--gold); }
.tag-warn { background:var(--error-light); color:var(--error); }

/* ---------- Buttons ---------- */
/* 微信原生 button 重置 */
button { margin:0; padding:0; line-height:1; }
button::after { display:none; }

.btn-gold {
  display:flex;
  align-items:center;
  justify-content:center;
  background:var(--gradient-gold);
  border-radius:9999rpx;
  padding:0 64rpx;
  height:96rpx;
  font-size:26rpx;
  color:#fff;
  font-weight:600;
  border:none;
  cursor:pointer;
  transition:all var(--transition);
  box-shadow:var(--shadow-btn);
  line-height:1.4;
}
.btn-gold:active { transform:scale(0.98); opacity:0.9; }
.btn-primary {
  display:flex;
  align-items:center;
  justify-content:center;
  background:var(--gradient-gold);
  border-radius:9999rpx;
  padding:0 64rpx;
  height:96rpx;
  font-size:26rpx;
  color:#fff;
  font-weight:600;
  border:none;
  cursor:pointer;
  transition:all var(--transition);
  box-shadow:var(--shadow-btn);
  line-height:1.4;
}
.btn-primary:active { transform:scale(0.98); box-shadow:var(--shadow-card); }
.btn-ghost {
  display:inline-block;
  background:var(--gold-light);
  border-radius:9999rpx;
  padding:12rpx 28rpx;
  font-size:24rpx;
  color:var(--gold);
  font-weight:600;
  border:none;
  cursor:pointer;
  transition:all var(--transition);
}
.btn-ghost:active { background:var(--gold-200); }
/* 描边线框按钮 */
.btn-outline {
  display:inline-block;
  background:var(--bg-card);
  border-radius:9999rpx;
  padding:12rpx 28rpx; font-size:24rpx;
  color:var(--gold); font-weight:600;
  border:3rpx solid var(--gold);
  cursor:pointer; transition:all var(--transition);
}
.btn-outline:active { background:var(--gold-light); }
.btn-sm { padding:10rpx 24rpx; font-size:24rpx; height:64rpx; }
.btn-lg { padding:20rpx 48rpx; font-size:28rpx; height:96rpx; }

/* ---------- Section Titles ---------- */
.section-title { display:flex; align-items:center; gap:16rpx; font-size:30rpx; font-weight:700; color:var(--text-primary); margin-bottom:28rpx; margin-top:40rpx; }
.section-title:first-child { margin-top:0; }
.section-title .gold-bar + text,
.section-title > text:last-child { flex:1; }

/* ---------- Loading / Empty / Error ---------- */
.loading-center { display:flex; flex-direction:column; align-items:center; justify-content:center; padding:120rpx 0; }
.loading-spinner { width:52rpx; height:52rpx; border:5rpx solid var(--gold-light); border-top-color:var(--gold); border-radius:50%; animation:spin .7s linear infinite; }
@keyframes spin { to { transform:rotate(360deg); } }
.loading-text { font-size:26rpx; color:var(--text-secondary); margin-top:20rpx; }
.empty-state { display:flex; flex-direction:column; align-items:center; justify-content:center; padding:96rpx 0; text-align:center; color:var(--text-muted); font-size:26rpx; }

/* ---------- Form System ---------- */
.form-overlay { position:fixed; top:0; left:0; right:0; bottom:0; background:rgba(0,0,0,0.45); z-index:100; display:flex; align-items:flex-end; justify-content:center; }
.form-modal { background:var(--bg-card); width:100%; border-radius:48rpx 48rpx 0 0; padding:48rpx 40rpx 64rpx; max-height:80vh; overflow-y:auto; animation:slideUp .35s var(--transition-slow); box-shadow:var(--shadow-xl); }
@keyframes slideUp { from { transform:translateY(100%); } to { transform:translateY(0); } }
.form-title { font-size:36rpx; font-weight:700; color:var(--text-primary); margin-bottom:40rpx; text-align:center; }
.form-group { margin-bottom:28rpx; }
.form-label { font-size:24rpx; color:var(--text-secondary); display:block; margin-bottom:8rpx; font-weight:500; }
.form-input { width:100%; padding:22rpx 28rpx; background:var(--bg-card); border:3rpx solid var(--border-light); border-radius:20rpx; font-size:28rpx; color:var(--text-primary); transition:border-color var(--transition); height:96rpx; box-sizing:border-box; }
.form-input:focus { border-color:var(--gold); background:var(--bg-card); outline:none; box-shadow:0 0 0 3rpx rgba(212,175,55,0.1); }
.form-row { display:flex; gap:20rpx; }
.form-btns { display:flex; gap:20rpx; margin-top:40rpx; }
.btn-cancel {
  display:flex;
  align-items:center;
  justify-content:center;
  background:var(--bg-card);
  border-radius:9999rpx;
  padding:0 40rpx;
  height:96rpx;
  font-size:26rpx;
  color:var(--text-secondary);
  font-weight:600;
  border:3rpx solid var(--border-light);
  cursor:pointer;
  transition:all var(--transition);
  line-height:1.4;
}
.btn-cancel:active { background:var(--gold-50); transform:scale(0.98); }
.form-btns .btn-cancel, .form-btns .btn-primary, .form-btns .btn-gold { flex:1; text-align:center; }

/* ---------- Tabs ---------- */
.tabs { display:flex; gap:12rpx; overflow-x:auto; -webkit-overflow-scrolling:touch; }
.tab { display:inline-flex; align-items:center; justify-content:center; gap:8rpx; padding:12rpx 28rpx; border-radius:32rpx; font-size:24rpx; font-weight:500; color:var(--text-secondary); background:var(--gold-100); white-space:nowrap; cursor:pointer; transition:all var(--transition); line-height:1; }
.tab.active { background:var(--gradient-gold); color:#fff; font-weight:600; box-shadow:var(--shadow-btn); }
.tab:active { transform:scale(0.98); }

/* ---------- Search Box ---------- */
.search-box { flex:1; background:var(--bg-card); border-radius:9999rpx; padding:16rpx 28rpx; border:2rpx solid var(--border-light); align-items:center; gap:12rpx; }
.search-box-icon { font-size:28rpx; color:var(--gold-400); }
.search-box-input { flex:1; font-size:26rpx; }
.search-box:active { border-color:var(--gold-400); background:var(--bg-card); }

/* ---------- Stat Cards ---------- */
.stat-row { display:flex; gap:20rpx; margin-bottom:32rpx; align-items:stretch; }
.stat-card {
  flex:1;
  background:var(--bg-card);
  border-radius:48rpx;
  padding:28rpx 16rpx;
  display:flex;
  flex-direction:column;
  align-items:center;
  justify-content:center;
  text-align:center;
  box-shadow:var(--shadow-card);
  border:2rpx solid var(--border-light);
}
.stat-num { font-size:40rpx; font-weight:700; color:var(--gold); display:block; letter-spacing:-.6rpx; line-height:1.3; }
.stat-label { font-size:22rpx; color:var(--text-secondary); display:block; margin-top:8rpx; }

/* ---------- Ad Banner ---------- */
.ad-banner { width:100%; border-radius:48rpx; overflow:hidden; margin:24rpx 0; position:relative; }
.ad-placeholder { display:flex; align-items:center; justify-content:center; height:320rpx; background:var(--gradient-warm); border-radius:48rpx; position:relative; overflow:hidden; border:2rpx solid var(--border-light); }
.ad-placeholder::before { content:''; position:absolute; top:-50%; left:-50%; width:200%; height:200%; background:linear-gradient(45deg, transparent 40%, rgba(255,255,255,0.25) 50%, transparent 60%); animation:shimmer 2.5s infinite; }
@keyframes shimmer { to { transform:translateX(100%); } }
.ad-placeholder text { position:relative; z-index:1; font-size:26rpx; color:var(--gold); letter-spacing:4rpx; }
.ad-banner-sm .ad-placeholder { height:160rpx; }

/* ---------- Skeleton ---------- */
.skeleton-waterfall { display:flex; gap:20rpx; }
.skeleton-col { flex:1; display:flex; flex-direction:column; gap:20rpx; }
.skeleton-card { background:var(--bg-card); border-radius:48rpx; overflow:hidden; box-shadow:var(--shadow-card); border:2rpx solid var(--border-light); }
.skeleton-cover { background:var(--gold-light); }
.skeleton-body { padding:28rpx 32rpx 32rpx; }
.skeleton-line { height:24rpx; background:linear-gradient(90deg, var(--gold-light) 25%, var(--bg-card) 50%, var(--gold-light) 75%); border-radius:var(--radius-sm); background-size:200% 100%; animation:shimmer 1.5s infinite; }
.skeleton-waterfall-col .w-60 { width:60%; }
.skeleton-waterfall-col .w-40 { width:40%; }
.skeleton-waterfall-col .w-55 { width:55%; }
.skeleton-waterfall-col .w-45 { width:45%; }
.skeleton-waterfall-col .w-65 { width:65%; }
.skeleton-waterfall-col .w-70 { width:70%; }
.skeleton-waterfall-col .w-50 { width:50%; }
.skeleton-waterfall-col .w-35 { width:35%; }

/* ---------- Toast ---------- */
.toast { position:fixed; top:160rpx; left:48rpx; right:48rpx; z-index:300; padding:24rpx 32rpx; border-radius:20rpx; font-size:26rpx; font-weight:500; display:flex; align-items:center; gap:16rpx; animation:toastIn .3s ease both; box-shadow:var(--shadow-lg); }
@keyframes toastIn { from { opacity:0; transform:translateY(-24rpx); } to { opacity:1; transform:translateY(0); } }
.toast-success { background:var(--success-light); color:var(--success); }
.toast-error { background:var(--error-light); color:var(--error); }
.toast-info { background:var(--gold-light); color:var(--gold); }

/* ---------- Misc Helpers ---------- */
.full-width { width:100%; }
.block { display:block; }
.relative { position:relative; }
.hidden { display:none; }

/* ---------- VueEditor 隐藏占位 ---------- */
.hide { display:none !important; }

/* ═══════ 全局时间轴组件 ═══════ */
.timeline {
  display:flex; flex-direction:column; gap:20rpx;
  padding-left:28rpx; position:relative;
}
.timeline::before {
  content:''; position:absolute;
  left:8rpx; top:12rpx; bottom:12rpx;
  width:4rpx; background:var(--border);
}
.tlnode { position:relative; }
.tlnode::before {
  content:''; position:absolute;
  left:-28rpx; top:10rpx;
  width:20rpx; height:20rpx;
  border-radius:50%;
  background:var(--bg-card);
  border:4rpx solid var(--border);
  transition:all .3s ease;
}
.tlnode.active::before {
  background:var(--gold); border-color:var(--gold);
  box-shadow:0 0 0 6rpx var(--gold-bg);
}
.tlnode-label { font-size:24rpx; color:var(--text-muted); display:block; }
.tlnode.active .tlnode-label { color:var(--gold-dark); font-weight:600; }
.tlnode-date { font-size:20rpx; color:var(--text-muted); display:block; margin-top:2rpx; }

/* ---------- SVG Icon System (replaces emoji) ---------- */
.svg-icon {
  display: block;
  background-size: contain;
  background-repeat: no-repeat;
  background-position: center;
  flex-shrink: 0;
}

/* 尺寸 */
.icon-12 { width: 24rpx; height: 24rpx; }
.icon-14 { width: 28rpx; height: 28rpx; }
.icon-16 { width: 32rpx; height: 32rpx; }
.icon-18 { width: 36rpx; height: 36rpx; }
.icon-20 { width: 40rpx; height: 40rpx; }
.icon-22 { width: 44rpx; height: 44rpx; }
.icon-24 { width: 48rpx; height: 48rpx; }
.icon-28 { width: 56rpx; height: 56rpx; }
.icon-32 { width: 64rpx; height: 64rpx; }
.icon-36 { width: 72rpx; height: 72rpx; }

