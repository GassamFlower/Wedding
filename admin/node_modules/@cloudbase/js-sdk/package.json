    "@cloudbase/storage": "*",
    "@cloudbase/types": "*",
    "@cloudbase/utilities": "*",
    "@cloudbase/wx-cloud-client-sdk": "^1.8.8",
    "@mattiasbuelens/web-streams-adapter": "^0.1.0",
    "bson": "^7.1.1",
    "jwt-decode": "^3.1.2",
    "lodash": "^4.17.21",
    "text-encoding-shim": "^1.0.5",
    "web-streams-polyfill": "^4.0.0"
  },
  "bundledDependencies": [
    "@cloudbase/ai",
    "@cloudbase/apis",
    "@cloudbase/app",
    "@cloudbase/auth",
    "@cloudbase/cloudrun",
    "@cloudbase/container",
    "@cloudbase/database",
    "@cloudbase/functions",
    "@cloudbase/model",
    "@cloudbase/mysql",
    "@cloudbase/oauth",
    "@cloudbase/realtime",
    "@cloudbase/storage",
    "@cloudbase/types",
    "@cloudbase/utilities"
  ],
  "browserslist": [
    "last 2 version",
    "> 1%",
