.env
.env.local
.env.*.local
*.pem
*.key
credentials.json
admin/.env

# ─── 构建产物 ───
admin/dist/
dist/

# ─── 微信小程序 ───
miniprogram_npm/
project.private.config.json

# ─── 云函数本地调试 ───
cloudfunctions/*/node_modules/

# ─── 日志 ───
*.log
npm-debug.log*
yarn-debug.log*
yarn-error.log*
logs/

# ─── 操作系统 ───
.DS_Store
Thumbs.db
*.swp
*.swo
*~

# ─── IDE & 编辑器 ───
.vscode/
.idea/
*.sublime-*
.cursor/

# ─── Python ───
__pycache__/
*.py[cod]
*.pyo
*.egg-info/
.Python

